    obj_add(npc_coord, cbhat1, 1, 600);
    mes("Discard your display teas to start collecting chompy hats."); 
}


[proc,give_display_tea]
def_int $space = inv_freespace(inv);
if($space = 0) {
    mes("You gently set the cup of display tea down... on the ground.");
}
inv_add(inv, display_tea, 1);


[proc,useful_quest_items]()(namedobj, int)
def_int $random = 0;
$random = random(13);

    if ($random < 1 & %goblinquest ! ^gobdip_complete) {
        $random = random(3);
        if ($random < 1) {
            obj_add(npc_coord, goblin_armour_orange, 1, ^lootdrop_duration);
        } else if ($random < 2) {
            obj_add(npc_coord, goblin_armour_darkblue, 1, ^lootdrop_duration);
        } else if ($random < 3) {
            obj_add(npc_coord, goblin_armour, 1, ^lootdrop_duration);
        } 
    } else if ($random < 2 & %waterfall_quest ! ^waterfall_complete) {
        obj_add(npc_coord, glarials_urn_full_waterfall_quest, 1, ^lootdrop_duration);
    } else if ($random < 3 & %hetty ! ^hetty_complete) {
        obj_add(npc_coord, rats_tail, 1, ^lootdrop_duration);
    } else if ($random < 4 & ( %fluffs = ^fluffs_not_started | %fluffs = ^fluffs_started | %fluffs = ^fluffs_paid_boy |  %fluffs = ^fluffs_gave_milk )){
        obj_add(npc_coord, seasoned_sardine, 1, ^lootdrop_duration);
    } else if ($random < 5 & %biohazard ! ^biohazard_complete) {
        obj_add(npc_coord, plaguesample, 1, ^lootdrop_duration);
    } else if ($random < 6 & (%hunt = ^hunt_not_started | %hunt = ^hunt_fetch_rum ) ) {
        obj_add(npc_coord, karamja_rum, 1, ^lootdrop_duration);
    } else if ($random < 7 & %scorpcatcher ! ^scorpcatcher_complete) {
        obj_add(npc_coord, scorpioncagefull, 1, ^lootdrop_duration);
    } else if ($random < 8 & %druidquest ! ^druid_complete) {
         $random = random(4);
        if ($random < 1) {
            obj_add(npc_coord, enchanted_rat_meat, 1, ^lootdrop_duration);
        } else if ($random < 2) {
            obj_add(npc_coord, enchanted_beef, 1, ^lootdrop_duration);
        } else if ($random < 3) {
            obj_add(npc_coord, enchanted_bear_meat, 1, ^lootdrop_duration);
        } else if ($random < 4) {
            obj_add(npc_coord, enchanted_chicken, 1, ^lootdrop_duration);
        }
    } else if ($random < 9 & %elenaquest ! ^elena_complete_read_scroll) {
        obj_add(npc_coord, hangover_cure, 1, ^lootdrop_duration); 
    } else if ($random < 10 & %desertrescue ! ^desertrescue_complete) {
        obj_add(npc_coord, thprotodart, 1, ^lootdrop_duration); 
    } else if ($random < 11 & ( %haunted = ^haunted_not_started | %haunted = ^haunted_started )) {
        obj_add(npc_coord, oil_can, 1, ^lootdrop_duration); 
    } else if ($random < 12 & %upass ! ^upass_complete) {
        obj_add(npc_coord, old_journal, 1, ^lootdrop_duration); 
    } else if ($random < 13 & ( %itwatchtower ! ^itwatchtower_complete & %itwatchtower ! ^itwatchtower_complete_read_scroll )) {
        $random = random(3);
        if ($random < 1) {
            obj_add(npc_coord, relicpart1, 1, ^lootdrop_duration);
        } else if ($random < 2) {
            obj_add(npc_coord, relicpart2, 1, ^lootdrop_duration);
        } else if ($random < 3) {
            obj_add(npc_coord, relicpart3, 1, ^lootdrop_duration);
        }
    } else{
        ~lucky_draw;
    }


// Unobtainable item table
[proc,unobtain_roll]()(namedobj, int)
def_int $random = 0;
$random = random(20);

// rare roll potential only if player has at least one untradeable holiday item (bank, inv, or worn)
if ( inv_total(worn, bunnyears) > 0 | inv_total(inv, bunnyears) > 0 | inv_total(bank, bunnyears) > 0 | inv_total(worn, scythe) > 0 | inv_total(inv, scythe) > 0 | inv_total(bank, scythe) > 0 | inv_total(inv, grandtree_warship) > 0 | inv_total(bank, grandtree_warship) > 0 ) {
    $random = random(28); // 30 for easter event
} 

if (inv_total(worn, bunnyears) = 0 & inv_total(inv, bunnyears) = 0 & inv_total(bank, bunnyears) = 0) {
    obj_add(npc_coord, bunnyears, 1, 600);
} else if (inv_total(worn, scythe) = 0 & inv_total(inv, scythe) = 0 & inv_total(bank, scythe) = 0) {
    obj_add(npc_coord, scythe, 1, 600);
}

if ($random < 2) { // god capes
    def_int $god_capes_obtained = calc(  inv_total(worn, saradomin_cape) + inv_total(inv, saradomin_cape) + inv_total(bank, saradomin_cape) + 
                                        inv_total(worn, guthix_cape) + inv_total(inv, guthix_cape) + inv_total(bank, guthix_cape) + 
                                        inv_total(worn, zamorak_cape) + inv_total(inv, zamorak_cape) + inv_total(bank, zamorak_cape) 
                                        );
    if ($god_capes_obtained > 0) {
        $random = random(3);  
        if ( $random < 1 )
            obj_add(npc_coord, saradomin_cape, 1, 600);
        } else if ($random < 2) {
            obj_add(npc_coord, guthix_cape, 1, 600);
        } else if ($random < 3) {
            obj_add(npc_coord, zamorak_cape, 1, 600);
    } else {
        ~edible_roll;
    }
} else if ($random < 4) {
    obj_add(npc_coord, gauntlets_of_cooking, 1, ^lootdrop_duration);
} else if ($random < 6) {
    obj_add(npc_coord, gauntlets_of_goldsmithing, 1, ^lootdrop_duration);
} else if ($random < 8) {
    obj_add(npc_coord, gauntlets_of_chaos, 1, ^lootdrop_duration);
} else if ($random < 10) {
    obj_add(npc_coord, steel_gauntlets, 1, ^lootdrop_duration);
} else if ($random < 12) {
    obj_add(npc_coord, bullroarer, 1, ^lootdrop_duration);
} else if ($random < 14) {
    obj_add(npc_coord, zqcorpse, 1, ^lootdrop_duration); 
} else if ($random < 16) {
    obj_add(npc_coord, gertrudekittens, 1, ^lootdrop_duration);
} else if ($random < 18) {
    obj_add(npc_coord, felinemedal, 1, ^lootdrop_duration); 
} else if ($random < 20) { 
    obj_add(npc_coord, ice_gloves, 1, ^lootdrop_duration); 
} else{
    ~rare_roll;
}


