// Name unconfirmed
[proc,megararetable]()(namedobj, int)
def_int $random = random(128);
def_namedobj $drop = null;
if ($random < 8) { $drop = rune_spear; }
else if ($random < 12) { $drop = dragonshield_a; }
else if ($random < 15) { $drop = dragon_spear; }
if ($drop ! null) {
    session_log(^log_adventure, "Defeated a <npc_name> and received a <oc_name($drop)>!");
    return ($drop, 1);
}

[proc,randomjunk]()(namedobj, int) // guess
switch_int (random(8)) {
    case 0 : return(digsitearrow, 1);
    case 1 : return(digsiteglass, 1);
    case 2 : return(digsitestaff, 1);
    case 3 : return(digsitebuttons, 1);
    case 4 : return(digsitearmour1, 1);
    case 5 : return(old_boot, 1);
    case 6 : return(pot_empty, 1);
    case 7 : return(digsitesword, 1);
    case default : return(pot_empty, 1);
}


// RNG City drop tables //

// Super rare table
[proc,superrare_getitem]()(namedobj, int)
def_int $random = 0;
$random = random(100);

if ($random < 3) {
    obj_add(npc_coord, naturerune, 5, ^lootdrop_duration);
} else if ($random < 10) {
    obj_add(npc_coord, deathrune, 20, ^lootdrop_duration);
} else if ($random < 13) {
    obj_add(npc_coord, lawrune, 5, ^lootdrop_duration);
} else if ($random < 19) {
    obj_add(npc_coord, cosmicrune, 20, ^lootdrop_duration);
} else if ($random < 29) {
    obj_add(npc_coord, mindrune, 100, ^lootdrop_duration);
} else if ($random < 32) {
    obj_add(npc_coord, cert_jug_water, 10, ^lootdrop_duration);
} else if ($random < 39) {
    obj_add(npc_coord, cert_grapes, 5, ^lootdrop_duration);
} else if ($random < 48) {
    obj_add(npc_coord, cert_coal, 5, ^lootdrop_duration);
} else if ($random < 52) {
    obj_add(npc_coord, cert_seaweed, 5, ^lootdrop_duration);
} else if ($random < 55) {
    obj_add(npc_coord, cert_gold_ore, 5, ^lootdrop_duration);
} else if ($random < 57) {
    obj_add(npc_coord, cert_muddy_key, 2, ^lootdrop_duration);
} else if ($random < 63) {
    obj_add(npc_coord, rune_knife_p, 30, ^lootdrop_duration);
} else if ($random < 70) {
    obj_add(npc_coord, cert_bucket_sand, 5, ^lootdrop_duration);
} else if ($random < 78) {
    obj_add(npc_coord, mithril_dart_tip, 45, ^lootdrop_duration);
} else if ($random < 84) {
    obj_add(npc_coord, cert_mithril_bar, 5, ^lootdrop_duration);
} else if ($random < 85) {
    obj_add(npc_coord, cert_adamantite_bar, 5, ^lootdrop_duration);
} else if ($random < 90) {
    obj_add(npc_coord, cert_uncooked_redberry_pie, 1, ^lootdrop_duration);
} else if ($random < 95) {
    obj_add(npc_coord, cert_uncooked_meat_pie, 1, ^lootdrop_duration);
} else if ($random < 100) {
    ~gigararetable;
}


// Giga rare table
[proc,gigararetable]()(namedobj, int)
def_int $random = 0;
$random = random(100);

if ($random < 1) { 
    obj_add(npc_coord, poisoned_dagger_p, 1, 600);
    session_log(^log_adventure, "Defeated a <npc_name> and received a Poisoned dagger(p)!");
} if ($random < 18) { 
    ~rare_roll;
} else { 
    obj_add(npc_coord, dart_poisoned_p, 1000, ^lootdrop_duration);
}


