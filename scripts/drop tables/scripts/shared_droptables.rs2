[proc,banana_left_next]()(namedobj)
switch_obj (inv_getobj(worn, ^wearpos_lhand)) {
    case banana_left : return(banana_left_bronze);
    case banana_left_bronze : return(banana_left_iron);
    case banana_left_iron : return(banana_left_steel);
    case banana_left_steel : return(banana_left_black);
    case banana_left_black : return(banana_left_mithril);
    case banana_left_mithril : return(banana_left_adamant);
    case banana_left_adamant : return(banana_left_rune);
    case banana_left_rune : return(banana_left_dragon);
    case default : return(null);
}

[proc,lucky_draw]()(namedobj, int)
def_int $random = 0;
$random = random(50);

if ($random < 4) {
    obj_add(npc_coord, cert_poison_chalice, 2, ^lootdrop_duration);
} else if ($random < 10) {
    $random = random(10);
    if ($random < 4) {
        obj_add(npc_coord, cert_ugthanki_kebab, 2, ^lootdrop_duration); 
    } else {
        obj_add(npc_coord, cert_kebab, 2, ^lootdrop_duration);
    }
} else if ($random < 15) {
    obj_add(npc_coord, feather, calc(40 + random(90)), ^lootdrop_duration);
} else if ($random < 19) {
    obj_add(npc_coord, cert_flax, 10, ^lootdrop_duration);
} else if ($random < 27) {
    obj_add(npc_coord, mithril_seed, calc(10 + random(20)), ^lootdrop_duration);
} else if ($random < 29) {
    def_namedobj $drop = ~banana_left_next;
    def_int $rand_banana = 0;
    switch_obj ($drop) {
        case banana_left_bronze : $rand_banana = random(3);
        case banana_left_iron : $rand_banana = random(4);
        case banana_left_steel : $rand_banana = random(6);
        case banana_left_black : $rand_banana = random(10);
        case banana_left_mithril : $rand_banana = random(15);
        case banana_left_adamant : $rand_banana = random(23);
        case banana_left_rune : $rand_banana = random(35);
        case banana_left_dragon : $rand_banana = random(54);
        case default : $rand_banana = 999;
    }
    if ($rand_banana < 1) {
        session_log(^log_adventure, "Defeated a <npc_name> and received a <oc_name($drop)>!");
        obj_add(npc_coord, $drop, 1, 600);
    } else {
        obj_add(npc_coord, cert_bigoysterpearls, 1, ^lootdrop_duration);
    }
} else if ($random < 39) {
    $random = random(10);
    if ($random < 9) {
        obj_add(npc_coord, casket, calc(4 + random(4)), ^lootdrop_duration);
    } else {
        obj_add(npc_coord, casket, calc(10 + random(9)), ^lootdrop_duration);
    } 
} else if ($random < 41) {
    ~chompy_hat_get;
} else if (~chompy_hat_total > 0){
    ~superrare_getitem;
} else{
    ~chompy_hat_get;
}


