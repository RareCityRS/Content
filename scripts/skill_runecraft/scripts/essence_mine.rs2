[label,teleport_to_essence_mine](coord $tele_back_coord)
if(%runemysteries < ^runemysteries_complete) {
    // https://www.youtube.com/watch?v=E6fjnTE5vl8&t=189s
    mes("You need to have completed the Rune Mysteries Quest to use this feature.");
    return;
}
if_close;
%exit_essence_mine_coord = $tele_back_coord;
// this is lowercase
npc_say("Senventior disthine molenko!");
if ($tele_back_coord ! ^essence_mine_to_brimstail) { // brimstall anim buggy, need gnome equivalent (or no anim like OSRS)
    npc_anim(human_castcurse, 0); // No anim in osrs
}
spotanim_npc(curse_casting, 92, 0);
sound_synth(curse_all, 0, 0);
def_int $duration = ~player_projectile(npc_coord, coord, uid, curse_travel, 31, 31, 61, 16, 0, 128, 5);
// osrs is 100 but 70 lines up better with our different sound synth
spotanim_pl(curse_impact, 124, 70);
// IncompleteProjectile(id = 109, startHeight = 31, endHeigsht = 31, delay = 61, angle = 16, distOffset = 128)	
p_delay(4);
// select random coord
def_coord $coord = enum(int, coord, essence_mine_teleports, random(enum_getoutputcount(essence_mine_teleports)));
// select random coord at a radius of 1
$coord = map_findsquare($coord, 0, 1, ^map_findsquare_lineofsight);
p_telejump($coord);

// portal
[oploc1,essencemine_portal]
def_int $chance = random(100);
def_int $level = stat(runecraft);
mes("You feel a powerful force take hold of you...");
spotanim_pl(curse_impact, 124, 30);
sound_synth(teleport_all, 0, 0);
p_delay(3);
if ($level > 53) {
    if (random($chance) < 10) {
        p_telejump(map_findsquare(0_44_75_25_30,0,0,0)); // air altar
        return;
    } else if (random($chance) < 20) {
        p_telejump(map_findsquare(0_43_75_41_29,0,0,0)); // mind altar
        return;
    } else if (random($chance) < 25) {
        p_telejump(map_findsquare(0_42_75_37_32,0,0,0)); // water altar
        return;
    } else if (random($chance) < 30) {
        p_telejump(map_findsquare(0_41_75_33_30,0,0,0)); // earth altar
        return;
    } else if (random($chance) < 35) {
        p_telejump(map_findsquare(0_40_75_16_48,0,0,0)); // fire altar
        return;
    } else if (random($chance) < 40) {
        p_telejump(map_findsquare(0_39_75_27_38,0,2,0)); // body altar
        return;
    } else if (random($chance) < 50) {
        p_telejump(map_findsquare(0_33_75_10_33,0,0,0)); // cosmic altar
        return;
    } else if (random($chance) < 60) {
        p_telejump(map_findsquare(3_35_75_35_47,0,0,0)); // chaos altar
        return;
    } else if (random($chance) < 80) {
        p_telejump(map_findsquare(0_37_75_32_35,0,0,0)); // nature altar
        return;
    }
    p_telejump(map_findsquare(0_38_75_32_19,0,0,0)); // law altar
} else if ($level > 43) {
