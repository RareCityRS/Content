[opheld3,felinemedal_4] @catcity_medal_teleport("The amulet has three charges left.");
[opheld3,felinemedal_3] @catcity_medal_teleport("The amulet has two charges left.");
[opheld3,felinemedal_2] @catcity_medal_teleport("The amulet has one charge left.");
[opheld3,felinemedal_1] @catcity_medal_teleport("You use the amulet's last charge.");
[opheld3,felinemedal]
mes("The amulet has no charges left.");

[label,catcity_medal_teleport](string $message)
def_obj $item = last_item;
def_int $slot = last_slot;
if (~wilderness_level(coord) > ^catcity_medal_wilderness_limit) {
    mes("A mysterious force blocks your teleport.");
    return;
}
if (~pre_tele_checks(coord) = false) {
    return;
}
mes($message);
~player_teleport_normal(map_findsquare(^catcity_cactus_coord, 1, 1, ^map_findsquare_none));
inv_setslot(inv, $slot, oc_param($item, next_obj_stage), 1);

[oploc1,catcity_cactus]
anim(human_pickupfloor, 0);
def_obj $medal = null;
def_int $medal_slot = 0;
def_boolean $medal_worn = false;
def_obj $worn_medal = inv_getobj(worn, ^wearpos_front);
if ($worn_medal ! null) {
    if (oc_category($worn_medal) = feline_medal & $worn_medal ! felinemedal_4) {
        $medal = $worn_medal;
        $medal_slot = ^wearpos_front;
        $medal_worn = true;
    }
}
def_int $slot = 0;
while ($medal = null & $slot < inv_size(inv)) {
    def_obj $item = inv_getobj(inv, $slot);
    if ($item ! null) {
        if (oc_category($item) = feline_medal & $item ! felinemedal_4) {
            $medal = $item;
            $medal_slot = $slot;
        }
    }
    $slot = calc($slot + 1);
}
if (%catcity_medal_charges < ^catcity_medal_charge_max & inv_total(inv, viking_dummy_coin) < ^catcity_medal_charge_price) {
    mes("You scratch the cactus.");
    p_delay(1);
    queue(damage_player, 0, ~random_range(^catcity_cactus_scratch_min, ^catcity_cactus_scratch_max));
    mes("It scratches back!");
    p_delay(1);
    ~chatplayer("<p,neutral>I have a strange feeling it wants my red disks.");
    ~mesbox("You need <tostring(^catcity_medal_charge_price)> red disks to charge the amulet.");
    return;
}
if ($medal = null) {
    mes("You scratch the cactus.");
    return;
}
def_boolean $was_free = false;
if (%catcity_medal_charges >= ^catcity_medal_charge_max) {
    $was_free = true;
}
def_int $added = ~catcity_medal_charge_batch($medal, $medal_slot, $medal_worn);
mes("You scratch the cactus, somehow recharging one of your cat medals.");
if ($was_free = false & %catcity_medal_charges >= ^catcity_medal_charge_max) {
    mes("Recharging your cat training medals is now free.");
}

[oploc2,catcity_cactus]
if (%catcity_medal_charges >= ^catcity_medal_charge_max) {
    mes("You can recharge your cat training medals for free.");
    return;
}
def_int $remaining = sub(^catcity_medal_charge_max, %catcity_medal_charges);
mes("You have to pay for <tostring($remaining)> more cat medal charges before it becomes free.");

[opheldu,felinemedal] @catcity_medal_disk_charge;
[opheldu,felinemedal_1] @catcity_medal_disk_charge;
[opheldu,felinemedal_2] @catcity_medal_disk_charge;
[opheldu,felinemedal_3] @catcity_medal_disk_charge;
[opheldu,felinemedal_4] @catcity_medal_disk_charge;

[label,catcity_medal_disk_charge]
if (last_useitem ! viking_dummy_coin) {
    ~displaymessage(^dm_default);
    return;
}
if (distance(coord, ^catcity_cactus_coord) > 1) {
    mes("I need to be near a certain cactus to do that.");
    return;
}
if (last_item = felinemedal_4) {
    mes("The amulet is already fully charged.");
    return;
}
def_int $current = ~catcity_medal_charge_count(last_item);
def_boolean $was_free = false;
if (%catcity_medal_charges >= ^catcity_medal_charge_max) {
    $was_free = true;
}
def_int $added = ~catcity_medal_charge_batch(last_item, last_slot, false);
if ($added <= 0) {
    mes("You need <tostring(^catcity_medal_charge_price)> red disks to charge the amulet.");
    return;
}
~catcity_medal_charge_message(add($current, $added));
if ($was_free = false & %catcity_medal_charges >= ^catcity_medal_charge_max) {
    mes("Recharging your cat training medals is now free.");
}

[proc,catcity_medal_charge_batch](obj $item, int $slot, boolean $worn)(int)
def_int $current = ~catcity_medal_charge_count($item);
def_int $empty = sub(4, $current);
def_int $added = $empty;
if (%catcity_medal_charges < ^catcity_medal_charge_max) {
    $added = min($empty, divide(inv_total(inv, viking_dummy_coin), ^catcity_medal_charge_price));
    if ($added <= 0) {
        return(0);
    }
    inv_del(inv, viking_dummy_coin, multiply($added, ^catcity_medal_charge_price));
    %catcity_medal_charges = min(add(%catcity_medal_charges, $added), ^catcity_medal_charge_max);
}
def_namedobj $next = ~catcity_medal_stage_from_charges(add($current, $added));
if ($worn = true) {
    inv_setslot(worn, $slot, $next, 1);
} else {
    inv_setslot(inv, $slot, $next, 1);
}
return($added);

[proc,catcity_medal_charge_count](obj $item)(int)
if ($item = felinemedal_4) {
    return(4);
}
if ($item = felinemedal_3) {
    return(3);
}
if ($item = felinemedal_2) {
    return(2);
}
if ($item = felinemedal_1) {
    return(1);
}
return(0);

[proc,catcity_medal_stage_from_charges](int $charges)(namedobj)
if ($charges >= 4) {
    return(felinemedal_4);
}
if ($charges = 3) {
    return(felinemedal_3);
}
if ($charges = 2) {
    return(felinemedal_2);
}
if ($charges = 1) {
    return(felinemedal_1);
}
return(felinemedal);

[proc,catcity_medal_charge_message](int $charges)
if ($charges = 1) {
    mes("The amulet hums with feline energy. It now has one charge.");
} else if ($charges = 2) {
    mes("The amulet hums with feline energy. It now has two charges.");
} else if ($charges = 3) {
    mes("The amulet hums with feline energy. It now has three charges.");
} else {
    mes("The amulet hums with feline energy. It now has four charges.");
}
