[label,catcity_music_enter](int $area)
if (%catcity_music_area = $area) {
    return;
}
%catcity_music_area = $area;
if (%musicloop = 0) {
    softtimer(musicloop, 1);
}
@catcity_music_next;

[label,catcity_music_next]
if (%catcity_music_area = ^catcity_music_town) {
    @catcity_music_town;
}
if (%catcity_music_area = ^catcity_music_beach) {
    @catcity_music_beach;
}
@catcity_music_east;

[label,catcity_music_town]
switch_int(random(9)) {
    case 0 : @catcity_music_song("Adventure");
    case 1 : @catcity_music_song("Spirit");
    case 2 : @catcity_music_song("Expanse");
    case 3 : @catcity_music_song("Medieval");
    case 4 : @catcity_music_song("Garden");
    case 5 : @catcity_music_song("Forever");
    case 6 : @catcity_music_song("Parade");
    case 7 : @catcity_music_song("Book Of Spells");
    case 8 : @catcity_music_song("Doorways");
}

[label,catcity_music_beach]
switch_int(random(8)) {
    case 0 : @catcity_music_song("Voyage");
    case 1 : @catcity_music_song("Wander");
    case 2 : @catcity_music_song("Dream");
    case 3 : @catcity_music_song("Big Chords");
    case 4 : @catcity_music_song("Fishing");
    case 5 : @catcity_music_song("Forever");
    case 6 : @catcity_music_song("Riverside");
    case 7 : @catcity_music_song("Serene");
}

[label,catcity_music_east]
switch_int(random(8)) {
    case 0 : @catcity_music_song("Deep Wildy");
    case 1 : @catcity_music_song("Al Kharid");
    case 2 : @catcity_music_song("Duel Arena");
    case 3 : @catcity_music_song("Forbidden");
    case 4 : @catcity_music_song("Dangerous");
    case 5 : @catcity_music_song("Overture");
    case 6 : @catcity_music_song("Shine");
    case 7 : @catcity_music_song("Greatness");
}

[label,catcity_music_song](string $name)
db_find(music:name, $name);
def_dbrow $song = db_findnext;
if ($song = null) {
    return;
}
def_int $unlock;
def_int $bit;
$unlock, $bit = db_getfield($song, music:unlock, 0);
if ($unlock ! null) {
    if (testbit(~music_getvar($unlock), $bit) = ^false) {
        ~music_setvar($unlock, $bit);
    }
}
if (%musicplay ! 0) {
    if_settext(music:com_177, db_getfield($song, music:name, 0));
    @music_play(db_getfield($song, music:track, 0));
}
