[ai_timer,catcity_rat] @rat_moo;

[ai_queue2,catcity_rat]
if (random(1000) = 0 & sub(npc_stat(hitpoints), last_int) > 0) {
    @rat_moo;
    ~npc_rat_teleport;
}

