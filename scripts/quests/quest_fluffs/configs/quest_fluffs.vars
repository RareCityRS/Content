[lumberyard_fence_used]

// =====================================================
// Playfight state
// =====================================================

// Current state machine value (see ^cvc_state_*).
[cvc_state]
type=int

// Partner's npc_uid during fight, or last target during giveup/retreat.
[cvc_target_uid]
type=npc_uid

// Generic state-internal timer (fight duration, giveup hold).
[cvc_clock]
type=int

// =====================================================
// Cooldowns and gating
// =====================================================

// Counter incremented each tick the owner is offline. Reset by dispatch when online.
// Used by playfight scan filter to identify ghost cats (offline owners).
[cvc_offline_ticks]
type=int

// Cooldown gate. Set to map_clock + period after each scan and after fight exits.
// Scan filter requires partner's cvc_scan_clock <= map_clock to engage.
[cvc_scan_clock]
type=int

// Mirror of owner's worn-medal status, written each tick by dispatch.
// Avoids needing cross-player-context worn-inv reads from the scan proc.
[cvc_medal_worn]
type=int

// =====================================================
// Per-engagement state
// =====================================================

// Ticks self has been engaged. Used to enforce reciprocation grace period.
[cvc_engagement_age]
type=int

// During GIVEUP: stores former target's last coord (used by retreat to compute
// retreat direction). During RETREAT: stores the retreat target coord.
[cvc_home_coord]
type=coord

// Tick counter for retreat phase. Reset on entering retreat.
[cvc_retreat_age]
type=int
