// Name leaked
[proc,randomherb]()(namedobj, int) 
def_int $random = 0;

$random = random(132);

// drops 3-5 noted vials of water
obj_add(npc_coord, cert_vial_water, calc(2 + random(3)), ^lootdrop_duration); 

// Noted herbs/secondaries
if ($random < 32) {
    $random = random(2);
    if ($random < 1) {
        return (cert_unidentified_guam, 14);
    }else {
        return (cert_eye_of_newt, calc(10 + random(4)) );
    }
} else if ($random < 56) {
    $random = random(2);
    if ($random < 1) {
        return (cert_unidentified_marentill, 13);
    }else {
        return (cert_unicorn_horn, calc(9 + random(4)) );
    }
} else if ($random < 74) {
    $random = random(2);
    if ($random < 1) { return (cert_unidentified_tarromin, 12); }
    else { return (cert_limpwurt_root, calc(8 + random(4)) ); }
} else if ($random < 88) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_harralander, 11);}
    else {return (cert_red_spiders_eggs, calc(7 + random(4)) );}
} else if ($random < 99) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_ranarr, 10);}
    else { return (cert_snape_grass, calc(6 + random(4)) );}
} else if ($random < 107) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_irit, 9);}
    else {return (cert_eye_of_newt, calc(5 + random(4)) );}
} else if ($random < 113) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_avantoe, 8);}
    else {return (cert_mortmyremushroom, calc(5 + random(3)) );} 
} else if ($random < 118) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_kwuarm, 7);}
    else {return (cert_limpwurt_root, calc(4 + random(3)) );}
} else if ($random < 122) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_cadantine, 6);}
    else {return (cert_white_berries, calc(4 + random(2)) );}
} else if ($random < 125) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_lantadyme, 5);}
    else {return (cert_blue_dragon_scale, calc(3 + random(2)) );}
} else if ($random < 128) {
    return (cert_unidentified_toadflax, 4);
} else if ($random < 130) {
    $random = random(2);
    if ($random < 1) {return (cert_unidentified_dwarf_weed, 3);}
    else {return (cert_wine_of_zamorak, calc(2 + random(2)) );}
} else if ($random < 131) {
    return (cert_unidentified_snapdragon, 2);
} else if ($random < 132) {
    return (cert_unidentified_torstol, 1);
}

// Name leaked
[proc,randomjewel]()(namedobj, int)
def_int $random = 0;

if (inv_total(worn, ring_of_wealth) > 0 & map_members = ^true) {
    $random = random(65);
} else {
    $random = random(128);
}

if ($random < 32) {
    return (uncut_sapphire, 1);
} else if ($random < 48) {
    return (uncut_emerald, 1);
} else if ($random < 56) {
    return (uncut_ruby, 1); 
} else if ($random < 58) {
    return (uncut_diamond, 1);
} else if ($random < 59) {
    if (map_members = ^true) {
        return (rune_javelin, 5);
    }
} else if ($random < 60) {
    if (map_members = ^true) {
        return (keyhalf1, 1);
    }
} else if ($random < 61) {
    if (map_members = ^true) {
        return (keyhalf2, 1);
    }
} else if ($random < 65) {
    if (map_members = ^true) {
        if ($random < 62 & %legendsquest = ^legends_complete) {
            return (~megararetable);
        }
        if (coordz(coord) > 6400) {
            return (chaos_talisman, 1);
        } else {
            return (nature_talisman, 1);
        }
    }
}

