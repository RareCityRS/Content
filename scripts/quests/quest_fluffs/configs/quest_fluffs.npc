[kittens_mew]
vislevel=hide
name=Crate
desc=Can I hear kittens?
op1=Search
minimap=no
model1=model_loc_0_8
wanderrange=0
members=yes
moverestrict=nomove
blockwalk=all
timer=25

[gertrudescat]
vislevel=hide
name=Gertrudes cat
desc=A friendly feline?
walkanim=cat_walk
readyanim=cat_ready
op1=Pick-up
op3=Stroke
resizeh=80
resizev=80
model1=model_3010_npc
model2=model_3006_obj
members=yes
param=attack_anim,cat_attack
param=death_anim,cat_death

[lostkitten]
vislevel=hide
name=Kitten
desc=It looks lost.
walkanim=cat_walk
readyanim=cat_ready
resizeh=30
resizev=40
model1=model_3010_npc
model2=model_3006_obj
param=death_anim,cat_death

// =====================================================
// Pet cats. Stats per stage:
//   Kitten:    hp=15, atk=1,  str=1,  def=1,  agility=4
//              stat_mod = 8 + random(4)  (8-11)
//   Grown:     hp=25, atk=15, str=10, def=50, agility=3
//              stat_mod = 30 + random(30)  (30-59)
//   Overgrown: hp=40, atk=30, str=60, def=80, agility=1
//              stat_mod = 10 + random(20)  (10-29)
// Nature/vocal varies by colour. Black cats are vocal (Salem-style).
// =====================================================

[kittenpet1]
vislevel=hide
name=Kitten
desc=A friendly little pet.
walkanim=cat_walk
readyanim=cat_ready
op1=Pick-up
op3=Stroke
op4=Shoo-away
op5=Chase vermin
hitpoints=15
attack=1
strength=1
defence=1
resizeh=30
resizev=40
model1=model_3010_npc
model2=model_3006_obj
param=death_anim,cat_death
param=attack_anim,cat_pounce
param=damagetype,^slash_style
category=petcat
timer=1
param=pet_item_id,kittenobject
param=cat_next_id,growncat
param=cvc_agility,4
param=cvc_stat_base,8
param=cvc_stat_random,4
param=cat_needy,1
param=cat_playful,0
param=cat_friendly,1
param=cat_vocal,0
blockwalk=none

