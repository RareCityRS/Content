[proc,trail_clue_medium_insta_reward]
def_int $random = random(12);

switch_int ($random) {
     
    case 0 : obj_add(npc_coord, boots_ranger, 1, ^lootdrop_duration);
    case 1 : obj_add(npc_coord, adamant_full_helm_trim, 1, ^lootdrop_duration);
    case 2 : obj_add(npc_coord, adamant_platebody_trim, 1, ^lootdrop_duration);
    case 3 : obj_add(npc_coord, adamant_platelegs_trim, 1, ^lootdrop_duration);
    case 4 : obj_add(npc_coord, adamant_kiteshield_trim, 1, ^lootdrop_duration);
    case 5 : obj_add(npc_coord, adamant_platebody_gold, 1, ^lootdrop_duration);
    case 6 : obj_add(npc_coord, adamant_platelegs_gold, 1, ^lootdrop_duration);
    case 7 : obj_add(npc_coord, adamant_full_helm_gold, 1, ^lootdrop_duration);
    case 8 : obj_add(npc_coord, adamant_kiteshield_gold, 1, ^lootdrop_duration);
    case 9 : obj_add(npc_coord, headband_red, 1, ^lootdrop_duration);
    case 10 : obj_add(npc_coord, headband_black, 1, ^lootdrop_duration);
    case 11 : obj_add(npc_coord, headband_brown, 1, ^lootdrop_duration);
}
