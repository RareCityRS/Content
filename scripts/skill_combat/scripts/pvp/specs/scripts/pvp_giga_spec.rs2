[label,pvp_giga_sa]
p_delay(0);
if (%sa_attack = ^false | stat(hitpoints) = 0 | .stat(hitpoints) = 0 | .%death = ^true) {
    return;
}
if (~sa_enough_energy = false) {
    return;
}
def_obj $weapon = inv_getobj(worn, ^wearpos_rhand);
def_int $damagestyle = %damagestyle;
def_int $maxhit = %com_maxhit;
def_int $attackroll = scale(115, 100, ~player_attack_roll_specific(%damagetype));
~set_sa_vars(oc_param($weapon, sa_energy));
~set_pk_vars;
def_int $first_damage = ~pvp_giga_spec_hit($weapon, $damagestyle, $maxhit, $attackroll, false);
if ($first_damage > 0 & $first_damage >= scale(50, 100, $maxhit)) {
    ~pvp_giga_entangle($first_damage);
}
def_boolean $force_max = false;
if ($first_damage > 0) {
    $force_max = true;
}
p_delay(0);
%action_delay = add(map_clock, 7);
$first_damage = ~pvp_giga_spec_hit($weapon, $damagestyle, $maxhit, $attackroll, $force_max);

[proc,pvp_giga_spec_hit](obj $weapon, int $damagestyle, int $maxhit, int $attackroll, boolean $force_max)(int)
if (stat(hitpoints) = 0 | .stat(hitpoints) = 0 | .%death = ^true) {
    return(0);
}
anim(oc_param($weapon, slashattack_anim), 0);
sound_synth(oc_param($weapon, slash_sound), 1, 0);
.anim(.%com_defendanim, 20);
def_int $damage = 0;
def_boolean $hit = false;
def_int $defenceroll = ~.player_defence_roll_specific(^slash_style);
if (~.check_protect_prayer(^melee_style) = true) {
    $maxhit = scale(6, 10, $maxhit);
}
if ($force_max = true) {
    $hit = true;
    $damage = min($maxhit, .stat(hitpoints));
} else if (randominc($attackroll) > randominc($defenceroll)) {
    $hit = true;
    $damage = min(randominc($maxhit), .stat(hitpoints));
}
if ($hit = true) {
    ~give_combat_experience_pvp($damagestyle, $damage, ~pvp_xp_multiplier(~.player_combat_level));
    both_heropoints($damage);
}
.queue*(pvp_retaliate, 0)(uid);
~.pvp_damage(0, $damage);
def_int $poison_severity = oc_param($weapon, poison_severity);
if ($damage > 0 & $poison_severity > 0 & random(4) = 0) {
    .queue(poison_player, 0, $poison_severity);
}
return($damage);

[proc,pvp_giga_entangle](int $reserved_damage)
def_dbrow $spell_data = magic_spell_entangle;
if (~pvp_freeze_allowed($spell_data) = false) {
    return;
}
def_int $duration = ~player_projectile(coord, .coord, .uid, db_getfield($spell_data, magic_spell_table:spotanim_proj, 0));
def_synth $sound = db_getfield($spell_data, magic_spell_table:sound_success, 0);
sound_synth($sound, 1, 0);
.sound_synth($sound, 1, 0);
def_int $maxhit = db_getfield($spell_data, magic_spell_table:maxhit, 0);
if (~.check_protect_prayer(^magic_style) = true) {
    $maxhit = scale(6, 10, $maxhit);
}
def_int $damage = min(randominc($maxhit), max(0, sub(.stat(hitpoints), $reserved_damage)));
~.pvp_damage(calc($duration / 30 + 1), $damage);
stat_advance(hitpoints, scale(~pvp_xp_multiplier(~.player_combat_level), 1000, scale(133, 100, multiply($damage, 10))));
both_heropoints($damage);
.spotanim_pl(db_getfield($spell_data, magic_spell_table:spotanim_target, 0), $duration);
.queue*(pvp_retaliate, calc($duration / 30 + 1))(uid);
~pvp_freeze_effect($spell_data);
