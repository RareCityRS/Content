[oploc1,obstical_pipe4]
if(stat(agility) < 49) {
    ~mesbox("You need 49 agility to squeeze through the pipe.");
    return;
}
def_int $mod = -1;
def_coord $end_pipe_coord = 0_40_148_13_34;
def_coord $start = 0_40_148_18_34;
def_int $dir = ^exact_west;
if(loc_coord = $end_pipe_coord) {
    $mod = 1;
    $dir = ^exact_east;
    $end_pipe_coord = 0_40_148_16_34;
    $start = 0_40_148_12_34;
}
~forcewalk2($start);
if(%yanille_obstacle_pipe_used >= map_clock) {
    mes("The pipe is being used"); // todo: confirm, using the same as gnome course
    return;
}
%yanille_obstacle_pipe_used = calc(map_clock + 4);
~agility_exactmove(human_doublepipesqueeze, 30, 3, coord, movecoord(coord, calc(3 * $mod), 0, 0), 30, 126, $dir, true);
sound_synth(squeeze_in, 1, 0);
p_delay(0);
~change_merged_loc($end_pipe_coord);
~agility_exactmove(human_doublepipesqueeze, 30, 3, 0_40_148_15_34, movecoord(0_40_148_15_34, calc(3 * $mod), 0, 0), 30, 126, $dir, true);
sound_synth(squeeze_in, 1, 0);
stat_advance(agility, 75);

[oploc1,balancing_ledge3]
if(stat(agility) < 40) {
    ~mesbox("You need an Agility level of 40 to cross the ledge.");
    return;
}
def_int $dz = 1;
def_seq $walk_seq = human_walk_sidestepl;
def_seq $start_seq = human_into_sidestepl;
def_seq $end_seq = human_outof_sidestepl;
def_coord $start = 0_40_148_20_40;
if(coordz(loc_coord) > 9518) {
    $walk_seq = human_walk_sidestep;
    $start_seq = human_into_sidestep;
    $end_seq = human_outof_sidestep;
    $start = 0_40_148_20_48;
    $dz = -1;
}
if(coord ! $start & $dz > 0) {
    // do nothing if the player isn't on the start tile
    return;
}
// check if ledge is being used, not sure why this needs a check
// with no loc_anim/locmerge, maybe more obstacles used to have these checks? 
if(%yanille_ledge_used >= map_clock) {
    mes("The ledge is being used");
    return;
}
%yanille_ledge_used = calc(map_clock + 5);
anim($start_seq, 0);
~set_forcemove_bas($walk_seq);
mes("You put your foot on the ledge and try to edge across...");
sound_synth(balancing_ledge, 4, 0);
if($dz < 0) {
    p_teleport(movecoord($start, 0, 0, multiply($dz, 2)));
    p_delay(0);
    ~forcemove(movecoord(coord, 0, 0, multiply($dz, 2)));
} else {
    ~forcemove(movecoord($start, 0, 0, multiply($dz, 4)));
}
if(stat_random(agility, 65, 355) = false) {
    ~agility_delay_fail(movecoord(coord, -2, 0, 0), 0_40_149_18_44, calc((stat(hitpoints) * 20) / 100), "You slip and fall to the pit below.");
    ~update_bas;
    return;
}
sound_synth(balancing_ledge, 2, 0);
%yanille_ledge_used = calc(map_clock + 4);
~forcemove(movecoord(coord, 0, 0, multiply($dz, 3)));
sound_synth(balancing_ledge, 2, 0);
~forcemove(movecoord(coord, 0, 0, $dz));
p_delay(0);
anim($end_seq, 0);
~update_bas;
stat_advance(agility, 225);
mes("You skillfully edge across the gap.");

[oploc1,climbingcaverocks1]
if(stat(agility) < 67) {
    ~mesbox("You need an Agility level of 67 to climb this pile of rubble.");
    return;
}
~agility_climb_up(55, 0_40_148_55_34);
mes("You climb up the pile of rubble...");

[oploc1,climbingcaverocks2]
mes("You climb down the pile of rubble...");
p_telejump(0_40_149_56_35);

[oploc1,shuttwistedchest]
sound_synth(locked, 1, 0);
mes("The chest is locked.");

[oplocu,shuttwistedchest]
// https://youtu.be/A4crb0CaneU?si=ty3obEvZ9cIxbJ4F&t=278, typos are all intentional
if(last_useitem = sinister_key) {
    mes("you unlock the chest with your key...");
    p_delay(3);
    mes("A foul gas seeps from the chest");
    sound_synth(gas_hiss, 1, 0);
    if(%poison < 0) {
        mes("Luckily your poison antidote saves you from harm.");
    } else {
        queue(poison_player, 0, 27);
    }
    mes("You find a lot of herbs in the chest...");
    inv_del(inv, sinister_key, 1);
    inv_add(inv, cert_unidentified_harralander, 2);
    inv_add(inv, cert_unidentified_ranarr, 3);
    inv_add(inv, cert_unidentified_irit, 1);
    inv_add(inv, cert_unidentified_avantoe, 1);
    inv_add(inv, cert_unidentified_kwuarm, 1);
    inv_add(inv, cert_unidentified_torstol, 1);

def_int $random = 0;
$random = random(132);
// Noted herbs/secondaries
if ($random < 32) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_guam, 14);
    }else {
        inv_add(inv, cert_eye_of_newt, calc(10 + random(4)));
    }
} else if ($random < 56) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_marentill, 13);
    }else {
        inv_add(inv, cert_unicorn_horn, calc(9 + random(4)));
    }
} else if ($random < 74) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_tarromin, 12);
    }else {
        inv_add(inv, cert_limpwurt_root, calc(8 + random(4)));
    }
} else if ($random < 88) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_harralander, 11);
    }else {
        inv_add(inv, cert_red_spiders_eggs, calc(7 + random(4)));
    }
} else if ($random < 99) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_ranarr, 10);
    }else {
        inv_add(inv, cert_snape_grass, calc(6 + random(4)));
    }
} else if ($random < 107) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_irit, 9);
    }else {
        inv_add(inv, cert_eye_of_newt, calc(5 + random(4)));
    }
} else if ($random < 113) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_avantoe, 8);
    }else {
        inv_add(inv, cert_mortmyremushroom, calc(5 + random(3)));
    } 
} else if ($random < 118) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_kwuarm, 7);
    }else {
        inv_add(inv, cert_limpwurt_root, calc(4 + random(3)));
    }
} else if ($random < 122) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_cadantine, 6);
    }else {
        inv_add(inv, cert_white_berries, calc(4 + random(2)));
    }
} else if ($random < 125) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_lantadyme, 5);
    }else {
        inv_add(inv, cert_blue_dragon_scale, calc(3 + random(2)));
    }
} else if ($random < 128) {
    inv_add(inv, cert_unidentified_toadflax, 4);
} else if ($random < 130) {
    $random = random(2);
    if ($random < 1) {
        inv_add(inv, cert_unidentified_dwarf_weed, 3);
    }else {
        inv_add(inv, cert_wine_of_zamorak, calc(2 + random(2)));
    }
} else if ($random < 131) {
    inv_add(inv, cert_unidentified_snapdragon, 2);
} else if ($random < 132) {
    inv_add(inv, cert_unidentified_torstol, 1);
}

    // Temp note: dur updated
    loc_change(chestopen_inactive, 5);
    return;
}
~displaymessage(^dm_default);

[oploc1,trappedchaosaltar]
if (stat(prayer) >= stat_base(prayer)) {
    mes("You already have full prayer points.");
} else {
    // no seq
    mes("You recharge your prayer points.");
    sound_synth(prayer_recharge, 1, 0);
    stat_add(prayer, calc(stat_base(prayer) - stat(prayer)), 0);
}
p_delay(3);
mes("Suddenly a trap door opens beneath you...");
p_teleport(0_40_149_28_37);
sound_synth(door_open, 1, 0);
~damage_self(calc(((stat_base(hitpoints) * 15) / 100) + 1));

