[oploc1,muddy_chestclosed]
mes("The chest is locked.");
sound_synth(locked, 1, 0);

[oplocu,muddy_chestclosed]
if (last_useitem ! muddy_key) {
    ~displaymessage(^dm_default);
    return;
}
anim(human_openchest, 0);
sound_synth(chest_open, 1, 0);
mes("You unlock the chest with your key.");
p_delay(0);
// Temp note: dur updated
loc_add(loc_coord, muddy_chestopen, loc_angle, loc_shape, 2);
inv_del(inv, muddy_key, 1);
inv_add(inv, cert_mithril_bar, 10);
inv_add(inv, lawrune, 20);
inv_add(inv, cert_anchovie_pizza, 2);
inv_add(inv, cert_mithril_dagger, 2);
inv_add(inv, coins, 500);
inv_add(inv, deathrune, 40);
inv_add(inv, chaosrune, 40);
switch_int (random(4)) {
    case 0 : inv_add(inv, airrune, 400);
    case 1 : inv_add(inv, earthrune, 400);
    case 2 : inv_add(inv, waterrune, 400);
    case 3 : inv_add(inv, firerune, 400);
    case default : inv_add(inv, cosmicrune, 40);
}
inv_add(inv, cert_uncut_ruby, 10);

mes("You find some treasure in the chest!");
p_delay(0);

[oploc1,loc_1766]
p_teleport(0_47_60_8_9);

[oploc1,wildymirrorladdertop2]
p_teleport(0_47_160_8_9);

[oploc1,loc_1768]
p_teleport(0_47_60_62_16);
