[proc,grand_pumpkin_exchange]()(namedobj, int)
inv_del(inv, pumpkin, 1);
mes("You give Aggie a pumpkin, for some reason.");

def_namedobj $drop = null;
def_int $random = 0;
$random = random(4);

if($random < 1){
    $random = random(100);
    if ($random < 20) {
        $drop = discofreturning;
    } else if ($random < 30) {
        $drop = half_full_wine_jug;
    } else if ($random < 50) {
        $drop = santa_hat;
    } else if ($random < 70) {
        $drop = halloweenmask_green;
    } else if ($random < 80) {
        $drop = halloweenmask_blue;
    } else if ($random < 90) {
        $drop = halloweenmask_red;
    } else if ($random < 100) {
        $drop = christmas_cracker;
    }
    sound_synth(zap, 0, 0);
    session_log(^log_adventure, "Exchanged a pumpkin and received a <oc_name($drop)>!");
    inv_add(inv, $drop, 1);
    ~objbox($drop, "Inside the pumpkin you find a  <oc_name($drop)>.", 250, 0, 0);
} else{
    $random = random(30);
    mes("The pumpkin is empty, but as Aggie turns away you notice she drops something.");
    mes("You pick it up.");
    
    if ($random < 5) {
        $drop = coins;
        inv_add(inv, coins, 49999);
    }else if ($random < 10) {
        $drop = rune_claws;
    } else if ($random < 15) {
        $drop = rune_halberd;
    } else if ($random < 23) {
        $drop = rune_spear;
    } else if ($random < 27) {
        $drop = dragon_spear;
    } else if ($random < 29) {
        $drop = dragon_med_helm;
    } else if ($random < 30) {
        $drop = dragon_chainbody;
    }
    session_log(^log_adventure, "Exchanged a pumpkin and received a <oc_name($drop)>!");
    inv_add(inv, $drop, 1);
    ~objbox($drop, "There's nothing inside the pumpkin. Feeling bad, Aggie gives you a <oc_name($drop)>.", 250, 0, 0);
}
