[proc,trail_clue_easy_insta_reward]
def_int $random = random(13);

switch_int ($random) {
    case 0 : obj_add(npc_coord, black_platebody_trim, 1, ^lootdrop_duration);
    case 1 : obj_add(npc_coord, black_platelegs_trim, 1, ^lootdrop_duration);
    case 2 : obj_add(npc_coord, black_full_helm_trim, 1, ^lootdrop_duration);
    case 3 : obj_add(npc_coord, black_kiteshield_trim, 1, ^lootdrop_duration);
    case 4 : obj_add(npc_coord, black_platebody_gold, 1, ^lootdrop_duration);
    case 5 : obj_add(npc_coord, black_platelegs_gold, 1, ^lootdrop_duration);
    case 6 : obj_add(npc_coord, black_full_helm_gold, 1, ^lootdrop_duration);
    case 7 : obj_add(npc_coord, black_kiteshield_gold, 1, ^lootdrop_duration);
    case 8 : obj_add(npc_coord, highwaymanmask, 1, ^lootdrop_duration);
    case 9 : obj_add(npc_coord, berret_blue, 1, ^lootdrop_duration);
    case 10 : obj_add(npc_coord, berret_black, 1, ^lootdrop_duration);
    case 11 : obj_add(npc_coord, berret_white, 1, ^lootdrop_duration);
    case 12 : obj_add(npc_coord, boots_wizard, 1, ^lootdrop_duration);
}
