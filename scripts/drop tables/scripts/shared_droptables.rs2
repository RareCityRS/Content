// higher level/wilderness monster drop table
[proc,strong_boi_roll]()(namedobj, int)
def_int $random = 0;
$random = random(100);

if ($random < 6) {
    $random = random(10);
    if ($random < 9) {
        obj_add(npc_coord, mcannonball, calc(15 + random(14)), ^lootdrop_duration);
    } else{
        obj_add(npc_coord, mcannonball, calc(30 + random(29)), ^lootdrop_duration);
    }  
} else if ($random < 25) {
    $random = random(10);
    if ($random < 7) {
            obj_add(npc_coord, agilityarena_ticket, calc(2 + random(3)), ^lootdrop_duration); 
    } else {
            obj_add(npc_coord, agilityarena_ticket, calc(6 + random(9)), ^lootdrop_duration); 
    } 
} else if ($random < 36) {
    $random = random(10);
    if ($random < 9) {
        obj_add(npc_coord, archery_ticket, calc(25 + random(50)), ^lootdrop_duration);   
    } else {
        obj_add(npc_coord, archery_ticket, calc(75 + random(75)), ^lootdrop_duration);   
    }  
} else if ($random < 41) {
    obj_add(npc_coord, mithril_seed, calc(5 + random(5)), ^lootdrop_duration); 
} else if ($random < 46) {
    obj_add(npc_coord, macro_genilamp, 1, 600); 
} else if ($random < 48) {
    $random = random(35);
    if ($random < 5) {
        obj_add(npc_coord, growncatobject, 1, ^lootdrop_duration);
    } else if ($random < 10) {
        obj_add(npc_coord, growncatobject_light, 1, ^lootdrop_duration);
    } else if ($random < 15) {
        obj_add(npc_coord, growncatobject_bluegrey, 1, ^lootdrop_duration);
    } else if ($random < 20) {
        obj_add(npc_coord, growncatobject_brown, 1, ^lootdrop_duration);
    } else if ($random < 30) {
        obj_add(npc_coord, growncatobject_black, 1, ^lootdrop_duration);
    } else if ($random < 35) {
        obj_add(npc_coord, growncatobject_browngrey, 1, ^lootdrop_duration);
    }
} else if ($random < 50) {
    ~edible_roll;
} else if ($random < 54) {
    ~randomherb;
} else if ($random < 67) {
    ~useful_quest_items;
} else if ($random < 69) {
    ~chompy_hat_get;
} else if ($random < 70) {
    ~unobtain_roll;
} else {
    ~lucky_draw;
}


// Name unconfirmed
[proc,edible_roll]()(namedobj, int)
def_int $random = 0;
$random = random(60);

if ($random < 5) {
    obj_add(npc_coord, macro_triffidfruit, 1, ^lootdrop_duration); 
} else if ($random < 25) {
    obj_add(npc_coord, poison_chalice, 1, ^lootdrop_duration); 
} else {
    $random = random(10);

    if ($random < 1) {
        obj_add(npc_coord, ugthanki_kebab_bad, 1, ^lootdrop_duration); 
    } else if ($random < 5) {
        obj_add(npc_coord, ugthanki_kebab, 1, ^lootdrop_duration);
    } else {
        obj_add(npc_coord, kebab, 1, ^lootdrop_duration);
    }
}

[proc,lucky_draw]()(namedobj, int)
def_int $random = 0;
$random = random(50);
def_obj $obj1 = inv_getobj(worn, ^wearpos_hat);

if ($random < 4) {
    obj_add(npc_coord, cert_poison_chalice, 1, ^lootdrop_duration);
} else if ($random < 10) {
    $random = random(10);
    if ($random < 4) {
        obj_add(npc_coord, cert_ugthanki_kebab, 1, ^lootdrop_duration); 
    } else {
        obj_add(npc_coord, cert_kebab, 1, ^lootdrop_duration);
    }
} else if ($random < 15) {
    obj_add(npc_coord, feather, calc(40 + random(90)), ^lootdrop_duration);
} else if ($random < 19) {
    obj_add(npc_coord, cert_flax, 10, ^lootdrop_duration);
} else if ($random < 29) {
    obj_add(npc_coord, cert_bigoysterpearls, 1, ^lootdrop_duration);
} else if ($random < 39) {
    $random = random(10);
    if ($random < 9) {
        obj_add(npc_coord, cert_casket, calc(4 + random(4)), ^lootdrop_duration);
    } else {
        obj_add(npc_coord, cert_casket, calc(10 + random(9)), ^lootdrop_duration);
    } 
} else if ($random < 41) {
    ~chompy_hat_get;
} else if (($obj1 = cbhat18 | inv_total(inv, cbhat18) > 0 | inv_total(bank, cbhat18) > 0)){
    ~superrare_getitem;
} else{
    ~chompy_hat_get;
}


// Check under your seats everyone! You (might) get a chompy bird hunting hat! You (might) get a chompy bird hunting hat! You get (might) a chompy bird hunting hat!
[proc,chompy_hat_get]()(namedobj, int)
def_obj $obj1 = inv_getobj(worn, ^wearpos_hat);
def_int $cbhat18_worn = 0;
if ($obj1 = cbhat18){
    $cbhat18_worn = 1;
}


if ( calc($cbhat18_worn + inv_total(inv, cbhat18) + inv_total(bank, cbhat18)) > 0 ){
    def_int $random = 0;
    def_int $prestige = 0;

    if ( calc($cbhat18_worn + inv_total(inv, cbhat18) + inv_total(bank, cbhat18)) = 1 ){
        $random = random(3);
    } else if ( calc($cbhat18_worn + inv_total(inv, cbhat18) + inv_total(bank, cbhat18)) = 2 ){
        $random = random(7);
        $prestige = 18;
        if( calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) >= $prestige ){
            ~superrare_getitem;
        } else{
            mes("You need to collect more tea to complete chompy hat prestige mode.");
        }
    } else if ( calc($cbhat18_worn + inv_total(inv, cbhat18) + inv_total(bank, cbhat18)) = 3 ){
        $random = random(10);
        $prestige = 36;

        if( calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) >= $prestige ){
            ~superrare_getitem;
            ~superrare_getitem;
        } else{
            mes("You need to collect more tea to complete chompy hat prestige mode.");
        }
    } else if ( calc($cbhat18_worn + inv_total(inv, cbhat18) + inv_total(bank, cbhat18)) = 4 ){
        $random = random(12);
        $prestige = 54;
        if( calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) >= $prestige ){
            ~superrare_getitem;
            ~superrare_getitem;
        } else{
            mes("You need to collect more tea to complete chompy hat prestige mode.");
        }
    } else if ( calc($cbhat18_worn + inv_total(inv, cbhat18) + inv_total(bank, cbhat18)) = 5 ){
        $random = random(15);
        $prestige = 72;
        if( calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) >= $prestige ){
            ~superrare_getitem;
            ~superrare_getitem;
        } else{
