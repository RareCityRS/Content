                        obj_add(npc_coord, display_tea, 1, ^lootdrop_duration);
                    }
                    obj_add(npc_coord, cbhat5, 1, 600);
                } else{
                    if((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = calc(3 + $prestige))){
                        mes("You have a sneaking suspicion you would have received another chompy hat.");
                        ~give_display_tea;
                    } else{
                        mes("Oh no, you don't have enough tea! Drop any black Yeoman chompy hats you own.");
                    }
                }
            } else if ( $obj1 = cbhat3 | calc( inv_total(inv, cbhat3) + inv_total(bank, cbhat3) ) > 0 ) {                  
                if ( (calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) > calc(2 + $prestige)) ){
                    if((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = calc(3 + $prestige))){
                        ~give_display_tea;
                    } else{
                        mes("You already have enough tea.");
                        obj_add(npc_coord, display_tea, 1, ^lootdrop_duration);
                    }
                    obj_add(npc_coord, cbhat4, 1, 600);
                } else{
                    if((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = calc(2 + $prestige))){
                        mes("You have a sneaking suspicion you would have received another chompy hat.");
                        ~give_display_tea;
                    } else{
                        mes("Oh no, you don't have enough tea! Drop any red Yeoman chompy hats you own.");
                    }
                }
            } else if ( $obj1 = cbhat2 | calc( inv_total(inv, cbhat2) + inv_total(bank, cbhat2) ) > 0 ) {                  
                if ( (calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) > calc(1 + $prestige)) ){
                    if((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = calc(2 + $prestige))){
                        ~give_display_tea;
                    } else{
                        mes("You already have enough tea.");
                        obj_add(npc_coord, display_tea, 1, ^lootdrop_duration);
                    }
                    obj_add(npc_coord, cbhat3, 1, 600);
                } else{
                    if((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = calc(1 + $prestige))){
                        mes("You have a sneaking suspicion you would have received another chompy hat.");
                        ~give_display_tea;
                    } else{
                        mes("Oh no, you don't have enough tea! Drop any green Bowman chompy hats you own.");
                    }
                }
            } else if ( $obj1 = cbhat1 | calc( inv_total(inv, cbhat1) + inv_total(bank, cbhat1) ) > 0 ) {                  
                if ( (calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) > $prestige) ){
                    if((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = calc(1 + $prestige))){
                        ~give_display_tea;
                    } else{
                        mes("You already have enough tea.");
                        obj_add(npc_coord, display_tea, 1, ^lootdrop_duration);
                    }
                    obj_add(npc_coord, cbhat2, 1, 600);
                } else if((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = $prestige)){
                    mes("You have a sneaking suspicion you would have received another chompy hat.");
                    ~give_display_tea;
                }
            } else if ((calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = $prestige)) {
                ~give_display_tea;
                mes("Congratulations. You have reached the next chompy hat prestige.");
                mes("Pick up new chompy hat drops and discard lower tiers.");
                mes("(Do NOT drop your yellow Expert chompy hats!)");
                mes("Keep at least one inventory slot free for display teas.");
                mes("These must be kept in your bank or inventory to progress. Best of luck!");
                obj_add(npc_coord, cbhat1, 1, 600);
            } else{
                obj_add(npc_coord, cbhat1, 1, 600);
            }
    }else{
         ~roll_food;
    }
} else if (($cbhat18_total = 0) &
           (calc(inv_total(inv, display_tea) + inv_total(bank, display_tea)) = 0)) { // no hat and no tea
        if (($obj1 = cbhat17 | inv_total(inv, cbhat17) > 0 | inv_total(bank, cbhat17) > 0)) {
            obj_add(npc_coord, cbhat18, 1, 600);
            session_log(^log_adventure, "Defeated a <npc_name> and received a Chompy Bird Hat!");
        } else if (($obj1 = cbhat16 | inv_total(inv, cbhat16) > 0 | inv_total(bank, cbhat16) > 0)) {
            obj_add(npc_coord, cbhat17, 1, 600);
        } else if (($obj1 = cbhat15 | inv_total(inv, cbhat15) > 0 | inv_total(bank, cbhat15) > 0)) {
            obj_add(npc_coord, cbhat16, 1, 600);
        } else if (($obj1 = cbhat14 | inv_total(inv, cbhat14) > 0 | inv_total(bank, cbhat14) > 0)) {
            obj_add(npc_coord, cbhat15, 1, 600);
        } else if (($obj1 = cbhat13 | inv_total(inv, cbhat13) > 0 | inv_total(bank, cbhat13) > 0)) {
            obj_add(npc_coord, cbhat14, 1, 600);
        } else if (($obj1 = cbhat12 | inv_total(inv, cbhat12) > 0 | inv_total(bank, cbhat12) > 0)) {
            obj_add(npc_coord, cbhat13, 1, 600);
        } else if (($obj1 = cbhat11 | inv_total(inv, cbhat11) > 0 | inv_total(bank, cbhat11) > 0)) {
            obj_add(npc_coord, cbhat12, 1, 600);
        } else if (($obj1 = cbhat10 | inv_total(inv, cbhat10) > 0 | inv_total(bank, cbhat10) > 0)) {
            obj_add(npc_coord, cbhat11, 1, 600);
        } else if (($obj1 = cbhat9 | inv_total(inv, cbhat9) > 0 | inv_total(bank, cbhat9) > 0)) {
            obj_add(npc_coord, cbhat10, 1, 600);
        } else if (($obj1 = cbhat8 | inv_total(inv, cbhat8) > 0 | inv_total(bank, cbhat8) > 0)) {
            obj_add(npc_coord, cbhat9, 1, 600);
        } else if (($obj1 = cbhat7 | inv_total(inv, cbhat7) > 0 | inv_total(bank, cbhat7) > 0)) {
            obj_add(npc_coord, cbhat8, 1, 600);
        } else if (($obj1 = cbhat6 | inv_total(inv, cbhat6) > 0 | inv_total(bank, cbhat6) > 0)) {
            obj_add(npc_coord, cbhat7, 1, 600);
        } else if (($obj1 = cbhat5 | inv_total(inv, cbhat5) > 0 | inv_total(bank, cbhat5) > 0)) {
            obj_add(npc_coord, cbhat6, 1, 600);
        } else if (($obj1 = cbhat4 | inv_total(inv, cbhat4) > 0 | inv_total(bank, cbhat4) > 0)) {
            obj_add(npc_coord, cbhat5, 1, 600);
        } else if (($obj1 = cbhat3 | inv_total(inv, cbhat3) > 0 | inv_total(bank, cbhat3) > 0)) {
            obj_add(npc_coord, cbhat4, 1, 600);
        } else if (($obj1 = cbhat2 | inv_total(inv, cbhat2) > 0 | inv_total(bank, cbhat2) > 0)) {
            obj_add(npc_coord, cbhat3, 1, 600);
        } else if (($obj1 = cbhat1 | inv_total(inv, cbhat1) > 0 | inv_total(bank, cbhat1) > 0)) {
            obj_add(npc_coord, cbhat2, 1, 600);
        } else {
            obj_add(npc_coord, cbhat1, 1, 600);
        } 
} else {
    obj_add(npc_coord, cbhat1, 1, 600);
    mes("Discard your display teas to start collecting chompy hats."); 
}


[proc,give_display_tea]()(namedobj, int)
def_int $space = inv_freespace(inv);
if($space = 0) {
    mes("You gently set the cup of display tea down... on the ground.");
}
inv_add(inv, display_tea, 1);


[proc,useful_quest_items]()(boolean)
def_int $random = 0;
$random = random(13);

if ($random = 0 & %goblinquest < ^gobdip_complete) {
    $random = random(3);
    if ($random < 1) {
        obj_add(npc_coord, goblin_armour_orange, 1, ^lootdrop_duration);
    } else if ($random < 2) {
        obj_add(npc_coord, goblin_armour_darkblue, 1, ^lootdrop_duration);
    } else if ($random < 3) {
        obj_add(npc_coord, goblin_armour, 1, ^lootdrop_duration);
    }
} else if ($random = 1 & %waterfall_quest < ^waterfall_complete) {
    obj_add(npc_coord, glarials_urn_full_waterfall_quest, 1, ^lootdrop_duration);
} else if ($random = 2 & %hetty < ^hetty_complete) {
    obj_add(npc_coord, rats_tail, 1, ^lootdrop_duration);
} else if ($random = 3 & ( %fluffs < ^fluffs_complete )){
    obj_add(npc_coord, seasoned_sardine, 1, ^lootdrop_duration);
} else if ($random = 4 & %biohazard < ^biohazard_complete) {
    obj_add(npc_coord, plaguesample, 1, ^lootdrop_duration);
} else if ($random = 5 & %hunt < ^hunt_complete ) {
    obj_add(npc_coord, karamja_rum, 1, ^lootdrop_duration);
} else if ($random = 6 & %scorpcatcher < ^scorpcatcher_complete) {
    obj_add(npc_coord, scorpioncagefull, 1, ^lootdrop_duration);
} else if ($random = 7 & %druidquest < ^druid_complete) {
     $random = random(4);
    if ($random < 1) {
        obj_add(npc_coord, enchanted_rat_meat, 1, ^lootdrop_duration);
    } else if ($random < 2) {
        obj_add(npc_coord, enchanted_beef, 1, ^lootdrop_duration);
    } else if ($random < 3) {
        obj_add(npc_coord, enchanted_bear_meat, 1, ^lootdrop_duration);
    } else if ($random < 4) {
        obj_add(npc_coord, enchanted_chicken, 1, ^lootdrop_duration);
    }
} else if ($random = 8 & %elenaquest < ^elena_complete) {
    obj_add(npc_coord, hangover_cure, 1, ^lootdrop_duration);
} else if ($random = 9 & %desertrescue < ^desertrescue_complete) {
    obj_add(npc_coord, thprotodart, 1, ^lootdrop_duration);
} else if ($random = 10 & ( %haunted < ^haunted_complete )) {
    obj_add(npc_coord, oil_can, 1, ^lootdrop_duration);
} else if ($random = 11 & %upass < ^upass_complete) {
    obj_add(npc_coord, old_journal, 1, ^lootdrop_duration);
} else if ($random = 12 &  %itwatchtower < ^itwatchtower_complete ) {
    $random = random(3);
    if ($random < 1) {
        obj_add(npc_coord, relicpart1, 1, ^lootdrop_duration);
    } else if ($random < 2) {
        obj_add(npc_coord, relicpart2, 1, ^lootdrop_duration);
    } else if ($random < 3) {
        obj_add(npc_coord, relicpart3, 1, ^lootdrop_duration);
    }
} else{
    return(false);
}
return(true);

