[ai_timer,_petcat] @petcat_ai_tick;

[label,petcat_ai_tick]
if (finduid(%npc_attacking_uid) = true) {
    // Reset offline counter (used by playfight scan filter to skip ghosts)
    if (%cvc_offline_ticks ! 0) {
        %cvc_offline_ticks = 0;
    }
    // worn-medal status 
    if (inv_totalcat(worn, feline_medal) > 0) {
        %cvc_medal_worn = 1;
    } else {
        %cvc_medal_worn = 0;
    }
    // Playfight state dispatch
    def_int $wildy_level = ~wilderness_level(coord);
    if (%cvc_state = ^cvc_state_playfight) {
        ~cvc_playfight_tick;
    } else if (%cvc_state = ^cvc_state_giveup) {
        ~cvc_giveup_tick;
    } else if (%cvc_state = ^cvc_state_retreat) {
        ~cvc_retreat_tick;
    } else if (%cvc_state = ^cvc_state_normal & npc_param(cat_friendly) = 0 & %cvc_medal_worn = 1 & map_clock > %cvc_scan_clock) {
        if ($wildy_level > 0) {
            // Wildy: cats engage reliably when a partner is in range
            %cvc_scan_clock = add(map_clock, ^cvc_wildy_scan_period);
            ~cvc_playfight_scan;
        } else {
            // Safe areas: clock-gated period + 1-in-N inner roll
            %cvc_scan_clock = add(map_clock, ^cvc_safe_scan_period);
            if (random(^cvc_safe_scan_chance) = 0) {
                ~cvc_playfight_scan;
            }
        }
    }
    // Idle cat behaviour
    if (%cvc_state = ^cvc_state_normal) {
        // Salem dialogue
        if (npc_param(cat_vocal) = 1 & random(^blackcat_dialogue_chance) = 0) {
            npc_say(enum(int, string, blackcat_phrases, random(^blackcat_phrase_count)));
        }
        // Leash back to player
        if (coordy(coord) ! coordy(npc_coord) | npc_range(coord) > 15) {
            npc_tele(map_findsquare(coord, 1, 1, ^map_findsquare_lineofwalk));
            npc_setmode(playerfollow);
        }
        else if (npc_range(coord) > 6) {
            npc_setmode(playerfollow);
        }
        // Normal idle behaviour
        else {
            def_int $wander_die = 60;
            def_int $wander_radius = 2;
            if (npc_param(cat_needy) = 1) {
                $wander_die = 80;
                $wander_radius = 1;
            } else {
                $wander_die = 60;
                $wander_radius = 2;
            }
            if (npc_param(cat_playful) = 1 & random(500) = 0) {
                npc_anim(cat_rollingover, 0);
                npc_say("Purr...");
            }
            else if (npc_param(cat_needy) = 1 & random(300) = 0) {
                npc_say("Meeeew!");
                npc_setmode(playerfollow);
            }
            else if (random($wander_die) = 0) {
                def_coord $target = map_findsquare(coord, $wander_radius, $wander_radius, ^map_findsquare_lineofwalk);
                if ($target ! null) {
                    npc_setmode(none);
                    npc_walk($target);
                }
            }
        }
    }
    // Duplicate cat cleanup
    def_npc $my_type = npc_type;
    def_int $my_pet = npc_petid;
    def_int $expected = ~petcat_unnamed_count(nc_param(npc_type, pet_item_id));
    if ($my_pet > 0) {
        $expected = 0;
        if (~petcat_slot >= 0) {
            $expected = 1;
        }
    }
    def_int $count = 0;
    def_npc_uid $my_uid = npc_uid;
    npc_findallzone(coord);
    while (npc_findnext = true) {
        if (%npc_attacking_uid = uid & npc_type = $my_type & npc_petid = $my_pet) {
            $count = calc($count + 1);
        }
    }
    if ($count > $expected) {
        if (npc_finduid($my_uid) = true) {
            npc_del;
        }
    }
} else {
    // Owner offline check: forces exit of any non-normal state
    if (%cvc_state ! ^cvc_state_normal) {
        %cvc_state = ^cvc_state_normal;
        %cvc_target_uid = null;
        %cvc_clock = 0;
    }
    %cvc_offline_ticks = add(%cvc_offline_ticks, 1);
    if (%cvc_offline_ticks >= ^cat_offline_lifetime) {
        npc_del;
        return;
    }
    if (random(10) = 0) {
        def_coord $target = map_findsquare(npc_coord, 5, 5, ^map_findsquare_lineofwalk);
        if ($target ! null) {
            npc_setmode(none);
            npc_walk($target);
        }
    }
}
return;

[timer,petcat_growth]
if (%follower_uid = null) {
    cleartimer(petcat_growth);
    return;
}
if (npc_finduid(%follower_uid) = true) {
    def_namedobj $cat_item = nc_param(npc_type, pet_item_id);
    if ($cat_item = null | npc_category ! petcat | %npc_attacking_uid ! uid) {
        %follower_uid = null;
        %follower_obj = null;
        cleartimer(petcat_growth);
        return;
    }
    def_category $cat_cat = oc_category($cat_item);
    if (npc_petid > 0) {
        cleartimer(petcat_growth);
        return;
    }
    if ($cat_cat = overgrown) {
        cleartimer(petcat_growth);
        return;
    }
    def_int $growth = getbit_range(%cat_growth, 11, 19);
    npc_say("Meow!");
    %cat_growth = setbit_range_toint(%cat_growth, min(320,max(calc($growth + 1),-1)), 11, 19);
    if ($cat_cat = cat) {
        @cat_growth;
    }
    if ($cat_cat = kitten) {
        @kitten_growth;
    }
} else {
    %follower_uid = null;
    %follower_obj = null;
    cleartimer(petcat_growth);
}

[label,cat_growth]
if (npc_petid = 0 & getbit_range(%cat_growth, 11, 19) = 320) {
    def_int $pet_slot = ~petcat_slot;
    if ($pet_slot < 0) {
        return;
    }
    npc_changetype_keepall(nc_param(npc_type, cat_next_id), ^max_32bit_int);
    def_namedobj $new_item = nc_param(npc_type, pet_item_id);
    inv_setslot(pets, $pet_slot, $new_item, 1);
    %follower_uid = npc_uid;
    %follower_obj = $new_item;
    %cat_growth = 0;
    npc_say("Meeeooowww!");
    ~mesbox("Your cat has grown into a mighty feline,|but it will no longer be able to chase vermin.");
}

[label,kitten_growth]
def_int $hunger = getbit_range(%cat_growth, 0, 4);
def_int $attent = getbit_range(%cat_growth, 5, 10);
if ($attent = 0) { 
    $attent = 28;
}
if (npc_petid = 0 & getbit_range(%cat_growth, 11, 19) = 120) {
    def_int $pet_slot = ~petcat_slot;
    if ($pet_slot < 0) {
        return;
    }
    npc_changetype_keepall(nc_param(npc_type, cat_next_id), ^max_32bit_int);
    def_namedobj $new_item = nc_param(npc_type, pet_item_id);
    inv_setslot(pets, $pet_slot, $new_item, 1);
    %follower_uid = npc_uid;
    %follower_obj = $new_item;
    npc_say("Meeeooowww!");
    ~mesbox("Your kitten has grown into a healthy cat,|that can hunt for itself.");
    return;
}
if (npc_petid = 0) {
    %cat_growth = setbit_range_toint(%cat_growth, calc($hunger + 1), 0, 4);
    switch_int (getbit_range(%cat_growth, 0, 4)) {
        case 16 :
            npc_say("Miaow!");
            ~chatplayer("<p,scared>I think it's hungry!");
        case 18 :
            npc_say("Meeeooowww!");
            ~chatplayer("<p,scared>I think it's really hungry!");
        case 20 :
            mes("Your kitten has run away to look for food.");
            ~follower_death;
    }
}

%cat_growth = setbit_range_toint(%cat_growth, calc($attent + 1), 5, 10);
switch_int (getbit_range(%cat_growth, 5, 10)) {
    case 40 :
        npc_say("Purr...");
        ~chatplayer("<p,neutral>I think it wants some attention.");
    case 45 :
        npc_say("Meeeooowww...");
        ~chatplayer("<p,neutral>I think it's feeling lonely.");
    case 50 :
        mes("Your kitten got lonely and ran off.");
        ~follower_death;
}

[opheld5,kittenobject] ~cat_drop;
[opheld5,kittenobject_light] ~cat_drop;
[opheld5,kittenobject_brown] ~cat_drop;
[opheld5,kittenobject_black] ~cat_drop;
[opheld5,kittenobject_browngrey] ~cat_drop;
[opheld5,kittenobject_bluegrey] ~cat_drop;

[opheld5,growncatobject] ~cat_drop;
[opheld5,growncatobject_light] ~cat_drop;
[opheld5,growncatobject_brown] ~cat_drop;
[opheld5,growncatobject_black] ~cat_drop;
[opheld5,growncatobject_browngrey] ~cat_drop;
[opheld5,growncatobject_bluegrey] ~cat_drop;

[opheld5,overgrowncatobject] ~cat_drop;
[opheld5,overgrowncatobject_light] ~cat_drop;
[opheld5,overgrowncatobject_brown] ~cat_drop;
[opheld5,overgrowncatobject_black] ~cat_drop;
[opheld5,overgrowncatobject_browngrey] ~cat_drop;
[opheld5,overgrowncatobject_bluegrey] ~cat_drop;


[opnpcu,_petcat]
if (%npc_attacking_uid ! uid) {
    mes("This is not your cat.");
    return;
}
if (npc_petid > 0 & last_useitem ! ball_of_wool) {
    @petcat_name;
}
switch_obj(last_useitem) {
    case ball_of_wool :
        %cat_growth = setbit_range_toint(%cat_growth, 6, 5, 10);
        anim(human_pickupfloor, 0);
        npc_anim(cat_rollingover, 40); 
        npc_say("Purr!");
        p_delay(2);
        ~chatplayer("<p,happy>That kitten loves to play with that ball of wool.|I think it is its favourite.");
    case bucket_milk :
        %cat_growth = setbit_range_toint(%cat_growth, 0, 0, 4);
        inv_del(inv, last_useitem, 1);
        inv_add(inv, bucket_empty, 1);
        anim(human_pickupfloor, 0);
        p_delay(0);
        mes("The kitten laps up the milk.");
        npc_say("Purpurr");
    case raw_sardine :
        %cat_growth = setbit_range_toint(%cat_growth, 0, 0, 4);
        inv_del(inv, last_useitem, 1);
        anim(human_pickupfloor, 0);
        p_delay(0);
        ~cvc_feed_sardine;
        npc_say("Purr!");
    case raw_shrimp, raw_anchovies, raw_trout, trout, raw_salmon, salmon, raw_tuna, tuna :
        %cat_growth = setbit_range_toint(%cat_growth, 0, 0, 4);
        def_string $fishname = lowercase(oc_name(last_useitem));
        inv_del(inv, last_useitem, 1);
        anim(human_pickupfloor, 0);
        p_delay(0);
        mes("The kitten gobbles up the <$fishname>.");
        npc_say("Purr!");
    case tbwt_raw_karambwanji :
        ~feed_raw_karambwanji(1);
    case tbwt_cooked_karambwanji :
        %cat_growth = setbit_range_toint(%cat_growth, 0, 0, 4);
        def_string $karambwanji = lowercase(oc_name(last_useitem));
        inv_del(inv, last_useitem, 1);
        anim(human_pickupfloor, 0);
        p_delay(0);
        npc_statheal(hitpoints, 0, ^cat_karambwanji_heal_percent);
        mes("The kitten gobbles up the <$karambwanji>.");
        npc_say("Purr!");
    case default : @petcat_name;
}

[label,petcat_name]
def_obj $offering = last_useitem;
def_int $offering_slot = last_useslot;
def_npc_uid $cat_uid = npc_uid;
def_int $pet_id = npc_petid;
def_string $item_name = oc_name($offering);
def_string $stage = "Cat";
def_category $category = oc_category(nc_param(npc_type, pet_item_id));
if ($category = kitten) {
    $stage = "Kitten";
} else if ($category = overgrown) {
    $stage = "Overgrown Cat";
}
if (npc_petlocked = true) {
    if ($offering ! coins | compare(npc_name, "Coins") ! 0) {
        mes("Your cat likes its name so much that it doesn't want a new one.");
        return;
    }
    if (npc_petcoins = ^max_32bit_int) {
        mes("I don't think the cat wants any more gold coins.");
        return;
    }
}
def_int $amount = 1;
def_string $cat_name = npc_petname($offering, $amount);
if ($offering = coins) {
    ~objbox($offering, "You can donate coins to name your <$stage>, choosing how many coins to permanently destroy.", 250, 0, divide(^objbox_height, 2));
} else {
    ~objbox($offering, "Naming your cat will permanently destroy one <$item_name>. Its new name will be <$cat_name>, visible to other players.", 250, 0, divide(^objbox_height, 2));
}
if ($offering = christmas_cracker) {
    ~mesbox("Giving your cat a Christmas cracker gives an equal chance for you or your cat to receive the partyhat inside. If your cat wins, it will wear the hat. If you win, you get to keep the partyhat.|In either case, your cat is named after the Christmas cracker.");
}
if (npc_petlocked = true) {
    ~mesbox("Your cat already has the name Coins, but you can keep giving it coins if you like.");
} else if ($offering ! coins & compare($cat_name, $item_name) = 0) {
    ~mesbox("This will permanently name your cat <$item_name>.|It cannot be renamed again.");
} else {
    ~mesbox("Named cats and kittens stop growing and need no food or attention. You can replace its name by giving it another, different item.");
}
def_int $choice = 0;
if ($offering = coins) {
    $choice = ~p_choice2_header("Yes, take my coins and name my cat.", 1, "No, I want to keep my coins.", 2, "Permanently destroy coins?");
} else {
    $choice = ~p_choice2_header("Yes, destroy the item and name my cat after it.", 1, "No, I want to keep the item.", 2, "Permanently destroy one <$item_name>?");
}
if ($choice ! 1) {
    return;
}
if_close;
p_delay(0);
def_string $confirmation = p_stringdialog("Type the item name exactly: <$item_name>");
if (compare(lowercase($confirmation), lowercase($item_name)) ! 0) {
    mes("Your cat refuses the name you gave it, and the items too.");
    return;
}
~chatplayer("<p,neutral>Well, here goes nothing...");
if ($offering = coins) {
    if_close;
    p_delay(0);
    $confirmation = p_stringdialog("How many coins would you like to donate?");
    $amount = pet_coin_amount($confirmation);
    if ($amount <= 0) {
        return;
    }
}
if (npc_finduid($cat_uid) = false) {
    mes("Your cat didn't stick around long enough to take the name, or any items for that matter.");
    return;
}
if (%npc_attacking_uid ! uid | npc_petid ! $pet_id) {
    return;
}
if ($offering = coins) {
    if (inv_getobj(inv, $offering_slot) ! $offering | inv_getnum(inv, $offering_slot) <= 0) {
        return;
    }
    $amount = min($amount, inv_getnum(inv, $offering_slot));
    $cat_name = npc_petname($offering, $amount);
    if (npc_petcoins = ^max_32bit_int & compare(npc_name, "Coins") ! 0) {
        def_string $previous_name = npc_name;
        ~mesbox("WARNING: you are about to change your cat's name from <$previous_name> to Coins. This cannot be undone. Do you wish to proceed?");
        if (~p_choice2("Yes, change my <$stage>'s name from <$previous_name> to Coins.", 1, "No, keep <$previous_name>.", 2) ! 1) {
            return;
        }
        ~chatplayer("<p,neutral>Take my gold, I have far too much anyway.");
        if (npc_finduid($cat_uid) = false) {
            mes("Your cat didn't stick around long enough to take the name, or any coins for that matter.");
            return;
        }
        if (%npc_attacking_uid ! uid | npc_petid ! $pet_id) {
            return;
        }
    }
}
if (npc_namepet($offering, $offering_slot, $amount, $cat_name) = false) {
    mes("Your cat refuses the name you gave it, and the items too.");
    return;
}
if ($offering = christmas_cracker) {
    def_int $winner = random(2);
    def_namedobj $partyhat = ~cracker_partyhat;
    if ($winner = 1) {
        npc_pethat($partyhat);
        mes("Your cat wins the <oc_name($partyhat)>.");
    } else {
        inv_add(inv, $partyhat, 1);
        mes("You win the <oc_name($partyhat)> from the cracker.");
    }
}
if ($offering ! coins & npc_petlocked = true) {
    mes("Your cat takes the name you gave it, and likes it so much that it never wants a new one.");
}
if (%follower_uid = $cat_uid) {
    cleartimer(petcat_growth);
}
npc_say("Purrrr!");

[opnpc5,_petcat]
if (%npc_attacking_uid ! uid) {
    ~chatnpc("<p,neutral>Meow.");
    return;
}
def_string $line = "Purr!";
def_int $feed = 0;
~p_choice5("Talk to.", 1, "Feed raw karambwanji.", 2, "Stroke.", 3, "Chase Vermin.", 4, "Shoo away.", 5);
switch_component (last_com) {
    case multi5:com_1 :
        ~chatplayer("<p,quiz>Hey puss! Any news?");
        $line = ~petcat_phrase;
        ~chatnpc("<p,neutral><$line>");
    case multi5:com_2 :
        if_close;
        p_delay(0);
        p_countdialog;
        $feed = last_int;
        ~feed_raw_karambwanji($feed);
    case multi5:com_3 : p_opnpc(3);
    case multi5:com_4 : p_opnpc(4);
    case multi5:com_5 : @petcat_shoo;
}

[proc,petcat_phrase]()(string)
if (inv_totalcat(worn, feline_medal) = 0) {
    return("Purr!");
}
if (npc_type = kittenpet_black | npc_type = growncat_black | npc_type = overgrowncat_black) {
    return(enum(int, string, blackcat_phrases, random(^blackcat_phrase_count)));
}
return(enum(int, string, catcity_pet_phrases, random(^catcity_pet_phrase_count)));

[proc,feed_raw_karambwanji](int $amount)
def_int $have = inv_total(inv, tbwt_raw_karambwanji);
if ($have = 0) {
    mes("You don't have any raw karambwanji.");
    return;
}
if ($amount < 0) {
    $amount = ^max_32bit_int;
}
if ($amount > $have) {
    $amount = $have;
}
if ($amount > ^cat_karambwanji_feed_limit) {
    $amount = ^cat_karambwanji_feed_limit;
}
if ($amount <= 0) {
    return;
}
def_int $disks = ~karambwanji_disk_rolls($amount);
%cat_growth = setbit_range_toint(%cat_growth, 0, 0, 4);
inv_del(inv, tbwt_raw_karambwanji, $amount);
if ($disks > 0) {
    inv_add(inv, viking_dummy_coin, $disks);
}
anim(human_pickupfloor, 0);
p_delay(0);
npc_statheal(hitpoints, 0, min(calc(^cat_karambwanji_heal_percent * $amount), 100));
if ($amount = 1) {
    mes("The kitten gobbles up the raw karambwanji.");
} else {
    mes("The kitten gobbles up <tostring($amount)> raw karambwanji.");
}
if ($disks > 0) {
    if ($disks = 1) {
        ~objbox(viking_red_wooden_coin, "Your cat gobbles up <tostring($amount)> karambwanji and spits out a red disk.", 250, 0, divide(^objbox_height, 2));
    } else {
        ~objbox(viking_red_wooden_coin, "Your cat gobbles up <tostring($amount)> karambwanji and spits out <tostring($disks)> red disks.", 250, 0, divide(^objbox_height, 2));
    }
}
npc_say("Purr!");

[proc,karambwanji_disk_rolls](int $count)(int)
def_int $disks = 0;
def_int $roll = 0;
while ($roll < $count) {
    if (random(^catcity_fish_price_best) = 0) {
        $disks = add($disks, 1);
    }
    $roll = add($roll, 1);
}
return($disks);

[opnpc1,_petcat]
if (%npc_attacking_uid ! uid) {
    mes("That isn't yours to take.");
    return;
}
def_int $pet_slot = ~petcat_slot;
if ($pet_slot < 0) {
    if (%follower_uid = npc_uid) {
        %follower_obj = null;
        %follower_uid = null;
    }
    npc_del;
    return;
}
if (inv_freespace(inv) = 0) {
    mes("You don't have enough inventory space to pick up your cat.");
    return;
}
def_npc_uid $cat_uid = npc_uid;
def_int $pet_id = npc_petid;
p_delay(0);
if (npc_finduid($cat_uid) = false) {
    return;
}
if (%npc_attacking_uid ! uid | npc_petid ! $pet_id) {
    return;
}
$pet_slot = ~petcat_slot;
if ($pet_slot < 0) {
    return;
}
if (inv_moveslotcount(pets, inv, $pet_slot, 1) ! 1) {
    mes("You don't have enough inventory space to pick up your cat.");
    return;
}
sound_synth(pick, 0, 0);
if (%follower_uid = npc_uid) {
    %follower_obj = null;
    %follower_uid = null;
}
npc_del;

[opnpc3,_petcat]
if (%npc_attacking_uid ! uid) {
    mes("This is not your cat.");
//    return;
}
if(getbit_range(%cat_growth, 5, 10) = 28) { 
    %cat_growth = setbit_range_toint(%cat_growth, 23, 5, 10); 
} else {
    %cat_growth = setbit_range_toint(%cat_growth, 28, 5, 10); 
}
mes("You softly stroke your cat.");
anim(human_pickupfloor, 0);
npc_anim(cat_rollingover, 0);
p_delay(2);
npc_say("Purr...purr...");
~chatplayer("<p,happy>That cat sure loves to be stroked.");

[label,petcat_shoo]
if (%npc_attacking_uid ! uid) {
    mes("This is not your cat.");
    return;
}
def_npc_uid $cat_uid = npc_uid;
def_int $pet_id = npc_petid;
def_int $choice = ~p_choice2_header("Yes I am.", 1, "No I'm not.", 2, "Are you sure you want to shoo away the cat?");
if ($choice = 2) {
    mes("You choose not to shoo away the cat.");
    return;
}
if_close;
if (npc_finduid($cat_uid) = false) {
    return;
}
if (%npc_attacking_uid ! uid | npc_petid ! $pet_id) {
    return;
}
say("Shoo cat!");
npc_say("Meeeooow!");
npc_setmode(playerescape);
p_delay(4);
if (npc_finduid($cat_uid) = false) {
    return;
}
if (%npc_attacking_uid ! uid | npc_petid ! $pet_id) {
    return;
}
mes("The cat has run away.");
def_int $pet_slot = ~petcat_slot;
if ($pet_slot >= 0) {
    inv_delslot(pets, $pet_slot);
}
if (npc_uid = %follower_uid) {
    %follower_uid = null;
    %follower_obj = null;
    %cat_growth = 0;
}
npc_del;

[opnpc4,_petcat]
if (%npc_attacking_uid ! uid) {
    mes("This is not your cat.");
    return;
}
if (oc_category(nc_param(npc_type, pet_item_id)) = overgrown) {
    mes("The cat is just too big to catch vermin.");
    return;
}
if (.npc_find(coord, rat, 10, 1) = false) {
    if (.npc_find(coord, catcity_rat, 10, 1) = false) {
        if (.npc_find(coord, catcity_rat_desert, 10, 1) = false) {
            if (.npc_find(coord, catcity_rat_temp, 10, 1) = false) {
                mes("There aren't any rats or mice around.");
                return;
            }
        }
    }
}
def_int $chance = random(2);
def_int $vermin = getbit_range(%cat_growth, 20, 26);
say("Go on kitty...kill that rat!");
p_delay(0);
npc_say("Meeeeeoooowww!");
p_delay(0);
.npc_say("Eek!");
sound_synth(rat_hit, 0, 0);
if(lineofwalk(coord, .npc_coord) = false) {
    mes("Your cat cannot get to its prey.");
    return;
}
npc_setmode(none);
npc_walk(.npc_coord);
p_delay(1);
npc_anim(cat_pounce, 0);
p_delay(1);
if(oc_category(nc_param(npc_type, pet_item_id)) = kitten) {
    $chance = random(10);
}
if($chance ! 0) {
    mes("The rat manages to get away!");
    return;
}
.npc_del;
npc_say("MeeeoooooW!");
say("Hey well done kitty, you got it!");
%cat_growth = setbit_range_toint(%cat_growth, min(100,max(calc($vermin + 1),-1)), 20, 26);

[proc,cat_drop]
if (map_members = ^false) {
    mes(^mes_members_do_that);
    return;
}
// Follower cap: 5 by default, 28 if wearing a feline medal.
def_int $cap = 5;
def_string $cap_msg = "You can't have any more followers without a feline medal.";
if (inv_totalcat(worn, feline_medal) > 0) {
    $cap = 28;
    $cap_msg = "You can't have any more followers.";
}
def_int $current = sub(inv_size(pets), inv_freespace(pets));
if ($current >= $cap) {
    mes($cap_msg);
    return;
}
def_npc $follower_type = oc_param(last_item, follower_id);
if (inv_getobj(inv, last_slot) ! last_item) {
    return;
}
def_int $pet_slot = 0;
while ($pet_slot < inv_size(pets) & inv_getobj(pets, $pet_slot) ! null) {
    $pet_slot = add($pet_slot, 1);
}
if ($pet_slot >= inv_size(pets)) {
    return;
}
if (inv_moveslotcount(inv, pets, last_slot, 1) ! 1) {
    return;
}
sound_synth(put_down, 0, 0);
~cat_spawn_bound($follower_type, $pet_slot);

[proc,cat_spawn](npc $type)
def_int $pet_slot = 0;
while ($pet_slot < inv_size(pets) & inv_getobj(pets, $pet_slot) ! null) {
    $pet_slot = add($pet_slot, 1);
}
if ($pet_slot >= inv_size(pets)) {
    mes("You can't have any more followers.");
    return;
}
def_namedobj $item = nc_param($type, pet_item_id);
inv_setslot(pets, $pet_slot, $item, 1);
~cat_spawn_bound($type, $pet_slot);

[proc,cat_spawn_bound](npc $type, int $pet_slot)
npc_add(coord, $type, ^max_32bit_int);
%follower_obj = nc_param(npc_type, pet_item_id);
%follower_uid = npc_uid;
%npc_attacking_uid = uid;
npc_petbind(pets, $pet_slot);
npc_setmode(playerfollow);
npc_say("Miaow!");
if (npc_petid > 0) {
    cleartimer(petcat_growth);
} else {
    settimer(petcat_growth, 150);
}

[proc,follower_death]
if (npc_finduid(%follower_uid) = true) {
    def_int $pet_slot = ~petcat_slot;
    if ($pet_slot >= 0) {
        inv_delslot(pets, $pet_slot);
    }
    %follower_uid = null;
    %follower_obj = null;
    %cat_growth = 0;
    npc_del;
}

[proc,follower_logout]
return;

[queue,follower_login]
if (%follower_obj ! null & inv_total(pets, %follower_obj) = 0 & oc_param(%follower_obj, follower_id) ! null) {
    inv_add(pets, %follower_obj, 1);
}

def_int $i = 0;
def_int $size = inv_size(pets);
while ($i < $size) {
    def_obj $item = inv_getobj(pets, $i);
    if ($item ! null) {
        if (inv_petid(pets, $i) > 0) {
            ~petcat_reconcile_named($i);
        } else {
            def_int $j = 0;
            def_int $skip = 0;
            while ($j < $i) {
                if (inv_getobj(pets, $j) = $item & inv_petid(pets, $j) = 0) { $skip = 1; }
                $j = calc($j + 1);
            }
            if ($skip = 0) {
                ~reconcile_type($item);
            }
        }
    }
    $i = calc($i + 1);
}

npc_findallzone(coord);
while (npc_findnext = true) {
    if (npc_category = petcat & %npc_attacking_uid = uid) {
        if (~petcat_slot < 0) {
            npc_del;
        }
    }
}

def_npc_uid $tracked_uid = null;
def_namedobj $tracked_obj = null;
def_npc_uid $first_uid = null;
def_namedobj $first_obj = null;

npc_findallzone(coord);
while (npc_findnext = true) {
    if (npc_category = petcat & %npc_attacking_uid = uid) {
        def_namedobj $type_item = nc_param(npc_type, pet_item_id);
        npc_setmode(playerfollow);
        if ($first_uid = null) {
            $first_uid = npc_uid;
            $first_obj = $type_item;
        }
        if ($tracked_uid = null & %follower_obj ! null & $type_item = %follower_obj) {
            $tracked_uid = npc_uid;
            $tracked_obj = $type_item;
        }
    }
}

if ($tracked_uid = null) {
    $tracked_uid = $first_uid;
    $tracked_obj = $first_obj;
}

if ($tracked_uid = null) {
    %follower_uid = null;
    %follower_obj = null;
    cleartimer(petcat_growth);
    return;
}

%follower_uid = $tracked_uid;
%follower_obj = $tracked_obj;
if (npc_finduid($tracked_uid) = true) {
    if (npc_petid > 0) {
        cleartimer(petcat_growth);
        return;
    }
}
settimer(petcat_growth, 150);

[proc,reconcile_type](obj $item)
def_npc $follower_type = oc_param($item, follower_id);
if ($follower_type = null) return;
def_int $expected = ~petcat_unnamed_count($item);

def_int $existing = 0;
npc_findallzone(coord);
while (npc_findnext = true) {
    if (%npc_attacking_uid = uid & npc_type = $follower_type & npc_petid = 0) {
        $existing = calc($existing + 1);
    }
}

if ($existing > $expected) {
    def_int $to_despawn = sub($existing, $expected);
    npc_findallzone(coord);
    while (npc_findnext = true) {
        if ($to_despawn > 0 & %npc_attacking_uid = uid & npc_type = $follower_type & npc_petid = 0) {
            npc_del;
            $to_despawn = sub($to_despawn, 1);
        }
    }
}

if ($existing < $expected) {
    def_int $to_spawn = sub($expected, $existing);
    while ($to_spawn > 0) {
        npc_add(coord, $follower_type, ^max_32bit_int);
        %npc_attacking_uid = uid;
        npc_setmode(playerfollow);
        $to_spawn = sub($to_spawn, 1);
    }
}


[proc,petcat_slot]()(int)
def_obj $item = nc_param(npc_type, pet_item_id);
if ($item = null) {
    return(-1);
}
def_int $pet_id = npc_petid;
def_int $slot = 0;
while ($slot < inv_size(pets)) {
    if (inv_getobj(pets, $slot) = $item & inv_petid(pets, $slot) = $pet_id) {
        return($slot);
    }
    $slot = add($slot, 1);
}
return(-1);

[proc,petcat_unnamed_count](obj $item)(int)
def_int $count = 0;
def_int $slot = 0;
while ($slot < inv_size(pets)) {
    if (inv_getobj(pets, $slot) = $item & inv_petid(pets, $slot) = 0) {
        $count = add($count, inv_getnum(pets, $slot));
    }
    $slot = add($slot, 1);
}
return($count);

[proc,petcat_reconcile_named](int $slot)
def_obj $item = inv_getobj(pets, $slot);
def_int $pet_id = inv_petid(pets, $slot);
def_npc $type = oc_param($item, follower_id);
def_int $found = 0;
npc_findallzone(coord);
while (npc_findnext = true) {
    if (%npc_attacking_uid = uid & npc_petid = $pet_id) {
        if ($found = 0 & npc_type = $type) {
            npc_petbind(pets, $slot);
            npc_setmode(playerfollow);
            $found = 1;
        } else {
            npc_del;
        }
    }
}
if ($found = 0) {
    npc_add(coord, $type, ^max_32bit_int);
    %npc_attacking_uid = uid;
    npc_petbind(pets, $slot);
    npc_setmode(playerfollow);
}
