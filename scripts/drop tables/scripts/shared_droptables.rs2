            obj_add(npc_coord, gnome_hat_turquoise, 1, ^lootdrop_duration);
        }
    } else if ($random < 11) {
        $random = random(9);
        if ($random < 1) {
            obj_add(npc_coord, snelm_round_swamp, 1, ^lootdrop_duration);
        } else if ($random < 2) {
            obj_add(npc_coord, snelm_round_red+black, 1, ^lootdrop_duration);
        } else if ($random < 3) {
            obj_add(npc_coord, snelm_round_yellow, 1, ^lootdrop_duration);
        } else if ($random < 4) {
            obj_add(npc_coord, snelm_round_blue, 1, ^lootdrop_duration);
        } else if ($random < 5) {
            obj_add(npc_coord, snelm_round_orange, 1, ^lootdrop_duration);
        } else if ($random < 6) {
            obj_add(npc_coord, snelm_point_swamp, 1, ^lootdrop_duration);
        } else if ($random < 7) {
            obj_add(npc_coord, snelm_point_red+black, 1, ^lootdrop_duration);
        } else if ($random < 8) {
            obj_add(npc_coord, snelm_point_yellow, 1, ^lootdrop_duration);
        } else if ($random < 9) {
            obj_add(npc_coord, snelm_point_blue, 1, ^lootdrop_duration);
        }
    }
} else if ($random < 80) {
    obj_add(npc_coord, macro_genilamp, 1, 600);
} else if ($random < 100) {
    ~strong_boi_roll;
}


// higher level/wilderness monster drop table
[proc,strong_boi_roll]()(namedobj, int)
def_int $random = 0;
def_boolean $dropped = false;

while ($dropped = false) {
    $dropped = true;
    $random = random(100);

    if ($random < 6) {
        $random = random(10);
        if ($random < 9) {
            obj_add(npc_coord, mcannonball, calc(15 + random(14)), ^lootdrop_duration);
        } else{
            obj_add(npc_coord, mcannonball, calc(30 + random(29)), ^lootdrop_duration);
        }
    } else if ($random < 25) {
        $random = random(10);
        if ($random < 7) {
                obj_add(npc_coord, agilityarena_ticket, calc(2 + random(3)), ^lootdrop_duration);
        } else {
                obj_add(npc_coord, agilityarena_ticket, calc(6 + random(9)), ^lootdrop_duration);
        }
    } else if ($random < 36) {
        $random = random(10);
        if ($random < 9) {
            obj_add(npc_coord, archery_ticket, calc(25 + random(50)), ^lootdrop_duration);
        } else {
            obj_add(npc_coord, archery_ticket, calc(75 + random(75)), ^lootdrop_duration);
        }
    } else if ($random < 41) {
        ~quest_junk_table;
    } else if ($random < 46) {
        obj_add(npc_coord, macro_genilamp, 1, 600);
    } else if ($random < 48) {
        $random = random(35);
        if ($random < 5) {
            obj_add(npc_coord, growncatobject, 1, ^lootdrop_duration);
        } else if ($random < 10) {
            obj_add(npc_coord, growncatobject_light, 1, ^lootdrop_duration);
        } else if ($random < 15) {
            obj_add(npc_coord, growncatobject_bluegrey, 1, ^lootdrop_duration);
        } else if ($random < 20) {
            obj_add(npc_coord, growncatobject_brown, 1, ^lootdrop_duration);
        } else if ($random < 30) {
            obj_add(npc_coord, growncatobject_black, 1, ^lootdrop_duration);
        } else if ($random < 35) {
            obj_add(npc_coord, growncatobject_browngrey, 1, ^lootdrop_duration);
        }
    } else if ($random < 50) {
        ~roll_food;
    } else if ($random < 54) {
        obj_add(npc_coord, ~randomherb, ^lootdrop_duration);
    } else if ($random < 67) {
        $dropped = ~useful_quest_items;
    } else if ($random < 69) {
        ~chompy_hat_get;
    } else if ($random < 70) {
        ~unobtain_roll;
    } else {
        ~lucky_draw;
    }
}

