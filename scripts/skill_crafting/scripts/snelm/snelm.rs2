[opheldu,_category_3]
if(last_useitem = chisel) @craft_snelm(last_item);
~displaymessage(^dm_default);

// weakqueued in osrs
[label,craft_snelm](obj $shell)
def_int $level = 15;
if ($shell = snelm_point_orange_broken) { $level = 65; }
if(stat(crafting) < $level) {
    mes("You need a Crafting level of <tostring($level)> to craft the shell into a helmet."); // osrs
    return;
}
inv_del(inv, $shell, 1);
inv_add(inv, oc_param($shell, next_obj_stage), 1);
mes("You chisel the shell into a helmet.");
anim(human_snailshellcutting, 0);
stat_advance(crafting, 325);
def_int $random = random(33901);
if ($random < 1) {
    ~edible_roll_proc;
}
sound_synth(chisel, 1, 0);

[proc,snelm_reduction](int $damage)(int)
def_obj $head = inv_getobj(worn, ^wearpos_hat);
if($head = null) {
    return ($damage);
}
def_int $reduction = 0;
if($head = snelm_round_red+black | $head = snelm_point_red+black | $head = snelm_point_blue | $head = snelm_point_orange_broken | $head = snelm_point_orange_cut | ~cbsnelm_hat_count($head) > 0) {
    $reduction = 12;
} else if($head = snelm_round_blue | $head = snelm_round_orange | $head = snelm_point_yellow) {
    $reduction = 8;
} else if($head = snelm_round_swamp | $head = snelm_point_swamp | $head = snelm_round_yellow) {
    $reduction = 4;
}
return (max(0, sub($damage, $reduction)));
